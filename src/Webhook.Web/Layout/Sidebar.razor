    <!-- Nav items -->
    <div class="sidebar-nav">

        <!-- Main -->
        <div>
            <p class="sidebar-section-label">Main</p>
            <div class="sidebar-section-items">
                <NavLink class="nav-item" href="/dashboard" Match="NavLinkMatch.All">
