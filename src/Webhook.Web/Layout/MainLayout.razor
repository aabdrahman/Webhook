@inherits LayoutComponentBase

@* MainLayout.razor *@
<div class="app-shell">
    <Sidebar />
    <Navbar OnLogout="HandleLogout" />
    <main class="main-content">
        <div class="page-container">
            @Body
        </div>
    </main>
</div>

<ToastContainer />   @* ← this must be outside the app-shell grid *@

@code {
    private async Task HandleLogout()
    {
        await ((UserJwtAuthenticationStateProvider)authenticationStateProvider).NotifyUserLogout();
        navigationManager.NavigateTo("/login");
    }
}