@page "/reset-password"
@layout AuthLayout

<PageTitle>Reset Password — WebhookHub</PageTitle>

<div class="auth-card">

    <!-- Logo -->
    <div class="auth-logo">
        <div class="auth-logo-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
        </div>
        <span class="auth-logo-text">WebhookHub</span>
    </div>

    @if (_isInitializing)
    {
        <div class="auth-form">
            <SkeletonLoader Shape="text-lg" Width="55%" />
            <SkeletonLoader Shape="text"    Width="80%" />
            <div style="display:flex;flex-direction:column;gap:var(--space-2);margin-top:var(--space-2);">
                <SkeletonLoader Shape="text"   Width="30%" Height="10px" />
                <SkeletonLoader Shape="button" Width="100%" Height="42px" />
            </div>
            <div style="display:flex;flex-direction:column;gap:var(--space-2);">
                <SkeletonLoader Shape="text"   Width="35%" Height="10px" />
                <SkeletonLoader Shape="button" Width="100%" Height="42px" />
            </div>
            <SkeletonLoader Shape="button" Width="100%" Height="42px" />
        </div>
    }
    else if (_tokenMissing)
    {
        <!-- No operation token found — likely navigated here directly -->
        <div class="auth-form" style="align-items:center;text-align:center;">
            <Alert Type="error"
                   Title="Session expired"
                   Message="Your password reset session has expired or is invalid. Please request a new one." />

            <LoadingButton Text="Request New OTP"
                           Variant="primary"
                           FullWidth="true"
                           OnClick="NavigateToRequestOtp" />
        </div>
    }
    else
    {
        <!-- Heading -->
        <h1 class="auth-heading">Reset your password</h1>
        <p class="auth-subheading">Enter and confirm your new password below.</p>

        <!-- Success message -->
        <Alert Type="success"
               Message="@_successMessage"
               Visible="@(!string.IsNullOrWhiteSpace(_successMessage))" />

        <!-- API error alert -->
        <Alert Message="@_errorMessage" />

        <!-- Form -->
        <EditForm Model="_model"
                  OnValidSubmit="HandleResetPassword"
                  class="auth-form">

            <DataAnnotationsValidator />

            <!-- New password -->
            <div class="form-group">
                <label class="form-label form-label-required" for="newPassword">
                    New password
                </label>
                <div class="form-input-wrapper">
                    <svg class="form-input-icon-left" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input id="newPassword"
                           type="@(_showNewPassword ? "text" : "password")"
                           class="form-input has-icon-left has-icon-right"
                           placeholder="••••••••••"
                           @bind="_model.NewPassword"
                           @bind:event="oninput"
                           @onblur="HideNewPasswordOnBlur"
                           autocomplete="new-password"
                           disabled="@_isLoading" />
                    <button type="button"
                            class="form-input-icon-right"
                            @onmousedown:preventDefault
                            @onclick="ToggleNewPassword"
                            tabindex="-1"
                            aria-label="@(_showNewPassword ? "Hide password" : "Show password")">
                        @if (_showNewPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8
                                         a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8
                                         a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => _model.NewPassword)" class="form-error" />

                <!-- Password strength -->
                @if (!string.IsNullOrWhiteSpace(_model.NewPassword))
                {
                    <div class="password-strength">
                        <div class="password-strength-bars">
                            <div class="password-strength-bar @(_strength >= 1 ? StrengthClass : "")"></div>
                            <div class="password-strength-bar @(_strength >= 2 ? StrengthClass : "")"></div>
                            <div class="password-strength-bar @(_strength >= 3 ? StrengthClass : "")"></div>
                        </div>
                        <span class="password-strength-label @StrengthClass">
                            @StrengthLabel
                        </span>
                    </div>
                }
            </div>

            <!-- Confirm password -->
            <div class="form-group">
                <label class="form-label form-label-required" for="confirmPassword">
                    Confirm new password
                </label>
                <div class="form-input-wrapper">
                    <svg class="form-input-icon-left" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input id="confirmPassword"
                           type="@(_showConfirmPassword ? "text" : "password")"
                           class="form-input has-icon-left has-icon-right"
                           placeholder="••••••••••"
                           @bind="_model.ConfirmNewPassword"
                           @bind:event="oninput"
                           @onblur="HideConfirmPasswordOnBlur"
                           autocomplete="new-password"
                           disabled="@_isLoading" />
                    <button type="button"
                            class="form-input-icon-right"
                            @onmousedown:preventDefault
                            @onclick="ToggleConfirmPassword"
                            tabindex="-1"
                            aria-label="@(_showConfirmPassword ? "Hide password" : "Show password")">
                        @if (_showConfirmPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8
                                         a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8
                                         a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => _model.ConfirmNewPassword)"
                                   class="form-error" />
            </div>

            <!-- Submit -->
            <LoadingButton Text="Reset Password"
                           LoadingText="Resetting..."
                           IsLoading="@_isLoading"
                           FullWidth="true"
                           Type="submit" />

        </EditForm>
    }

</div>

@code {

    // -------------------------------------------------------------------------
    // Parameters
    // -------------------------------------------------------------------------

    /// <summary>
    /// Called on valid submit.
    /// Your side: read the operation token from localStorage,
    /// call AuthService.ResetPasswordAsync with token + new password,
    /// clear the token from localStorage on success.
    /// Returns error message on failure or empty string on success.
    /// </summary>
    // [Parameter]
    // public Func<string, string, Task<string>>? OnResetPassword { get; set; }

    /// <summary>
    /// Called on init to check whether a valid operation token exists
    /// in localStorage. Return true if token exists, false if missing.
    /// </summary>
    // [Parameter]
    // public Func<Task<bool>>? HasOperationToken { get; set; }

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private ResetUserPasswordequestDto _model = new();
    private bool _isInitializing = true;
    private bool _isLoading = false;
    private bool _showNewPassword  = false;
    private bool _showConfirmPassword = false;
    private bool _tokenMissing = false;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    // -------------------------------------------------------------------------
    // Password strength
    // -------------------------------------------------------------------------

    private int _strength => ComputeStrength(_model.NewPassword);

    private string StrengthClass => _strength switch
    {
        1 => "weak",
        2 => "medium",
        3 => "strong",
        _ => ""
    };

    private string StrengthLabel => _strength switch
    {
        1 => "Weak",
        2 => "Medium",
        3 => "Strong",
        _ => ""
    };

    private static int ComputeStrength(string password)
    {
        if (string.IsNullOrWhiteSpace(password)) return 0;
        int score = 0;
        if (password.Length >= 10)                                     score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit) || password.Any(c =>
            !char.IsLetterOrDigit(c)))                                 score++;
        return score;
    }

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        // Check operation token exists before showing the form
        await Task.Delay(500);
        var isTokenExists = await localStorageService.ContainKeyAsync(ApplicationClientHelper.VerifiedOtpTokenKey);
        if (!isTokenExists)
        {
            _tokenMissing = true;
        }

        _isInitializing = false;
    }

    // -------------------------------------------------------------------------
    // Password visibility
    // -------------------------------------------------------------------------

    private void ToggleNewPassword()     => _showNewPassword     = !_showNewPassword;
    private void ToggleConfirmPassword() => _showConfirmPassword = !_showConfirmPassword;

    private async Task HideNewPasswordOnBlur()
    {
        await Task.Delay(150);
        _showNewPassword = false;
    }

    private async Task HideConfirmPasswordOnBlur()
    {
        await Task.Delay(150);
        _showConfirmPassword = false;
    }

    // -------------------------------------------------------------------------
    // Handlers
    // -------------------------------------------------------------------------

    private async Task HandleResetPassword()
    {
        _errorMessage   = string.Empty;
        _successMessage = string.Empty;
        _isLoading      = true;

        try
        {
            var result = await resetPasswordHandler.HandleAsync(_model);
            //var result = new ApiResponseDto(DateTime.Now.Second % 2 == 0, "Simulated API response");
            _errorMessage = result.successStatus ? string.Empty : result.responseMessage;
            if (!result.successStatus)
            {
                return;
            }

            // Show success briefly before navigating
            _successMessage = "Password reset successfully. Redirecting to sign in...";
            StateHasChanged();

            await Task.Delay(2000);

            navigationManager.NavigateTo("/login?passwordReset=true");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateToRequestOtp()
        => navigationManager.NavigateTo("/request-otp?purpose=ChangePassword&returnUrl=/reset-password");
}