
@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="skeleton skeleton-chart-body"></div>
    </div>
}
else
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">Success Rate Trend</div>
                <div class="chart-subtitle">% successful deliveries per day</div>
            </div>
        </div>
        <ApexChart TItem="SuccessRateTrendDto"
                   Options="_options"
                   @ref="_chart"
                   Height="220">

            <ApexPointSeries TItem="SuccessRateTrendDto"
                             Items="Data"
                             Name="Success Rate"
                             XValue="d => d.Date.ToDateTime(TimeOnly.MinValue)"
                             YValue="d => d.SuccessRate"
                             SeriesType="SeriesType.Area" />
        </ApexChart>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<SuccessRateTrendDto> Data { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public decimal SlaTarget { get; set; } = 95m;

    private ApexChart<SuccessRateTrendDto>? _chart;
    private ApexChartOptions<SuccessRateTrendDto> _options = default!;

    protected override void OnInitialized()
    {
        _options = new ApexChartOptions<SuccessRateTrendDto>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false },
                FontFamily = "Inter, system-ui, sans-serif"
            },
            Colors = ["#2cb67d"],
            Fill = new Fill
            {
                Type = [FillType.Gradient],
                Gradient = new FillGradient
                {
                    ShadeIntensity = 1,
                    OpacityFrom = 0.35,
                    OpacityTo = 0.05,
                    Stops = [0, 100]
                }
            },
            Stroke = new Stroke { Curve = [Curve.Smooth], Width = [2] },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels
                {
                    DatetimeFormatter = new DatetimeFormatter { Day = "MMM dd" }
                },
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Min = 80,
                    Max = 100,
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(val) { return val.toFixed(0) + '%'; }"
                    }
                }
            ],
            Annotations = new Annotations
            {
                Yaxis =
                [
                    new AnnotationsYAxis
                    {
                        Y            = (double)SlaTarget,
                        BorderColor  = "#f59e0b",
                        BorderWidth  = 2,
                        StrokeDashArray = 5,
                        Label = new Label
                        {
                            Text            = $"Target {SlaTarget}%",
                            Style           = new Style { Color = "#f59e0b", Background = "transparent" },
                            Position        = LabelPosition.Right,
                            OffsetX         = -8
                        }
                    }
                ]
            },
            Grid = new Grid
            {
                BorderColor = "#e2e6ef",
                StrokeDashArray = 3,
                Xaxis = new GridXAxis { Lines = new Lines { Show = false } }
            },
            Legend = new Legend { Show = false },
            Markers = new Markers { Size = 0, Hover = new MarkersHover(){ Size = 5, SizeOffset = 3 } },
            Tooltip = new Tooltip
            {
                Y = new TooltipY
                {
                    Formatter = "function(val) { return val.toFixed(2) + '%'; }"
                }
            }
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart is not null && Data.Count > 0)
            await _chart.UpdateSeriesAsync(true);
    }
}