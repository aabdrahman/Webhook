
@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="latency-row">
            @for (int i = 0; i < 5; i++)
            {
                <div class="latency-tile skeleton"></div>
            }
        </div>
    </div>
}
else if (Data is not null)
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">Delivery Latency</div>
                <div class="chart-subtitle">Time from event raised to first attempt</div>
            </div>
        </div>
        <div class="latency-row">
            <div class="latency-tile">
                <div class="latency-pct">p50</div>
                <div class="latency-val">@FormatMs(Data.P50Ms)</div>
                <div class="latency-unit">@UnitLabel(Data.P50Ms) median</div>
            </div>
            <div class="latency-tile">
                <div class="latency-pct">p75</div>
                <div class="latency-val">@FormatMs(Data.P75Ms)</div>
                <div class="latency-unit">@UnitLabel(Data.P75Ms)</div>
            </div>
            <div class="latency-tile">
                <div class="latency-pct">p95</div>
                <div class="latency-val">@FormatMs(Data.P95Ms)</div>
                <div class="latency-unit">@UnitLabel(Data.P95Ms)</div>
            </div>
            <div class="latency-tile">
                <div class="latency-pct">p99</div>
                <div class="latency-val">@FormatMs(Data.P99Ms)</div>
                <div class="latency-unit">@UnitLabel(Data.P99Ms)</div>
            </div>
            <div class="latency-tile latency-tile--critical">
                <div class="latency-pct">Max</div>
                <div class="latency-val">@FormatMs(Data.MaxMs)</div>
                <div class="latency-unit">@UnitLabel(Data.MaxMs) worst</div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public LatencyPercentilesDto? Data { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private static string FormatMs(double ms) =>
        ms >= 1000 ? $"{ms / 1000:0.#}" : $"{Math.Round(ms)}";

    private static string UnitLabel(double ms) =>
        ms >= 1000 ? "s" : "ms";
}