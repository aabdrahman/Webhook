
@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="skeleton skeleton-chart-body"></div>
    </div>
}
else
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">@Title</div>
                <div class="chart-subtitle">@Subtitle</div>
            </div>
        </div>
        <ApexChart TItem="EventTypeDistributionDto"
                   Options="_options"
                   @ref="_chart"
                   Height="220">

            <ApexPointSeries TItem="EventTypeDistributionDto"
                             Items="Data"
                             Name="Events"
                             XValue="d => d.EventType"
                             YValue="d => d.Count"
                             SeriesType="SeriesType.Donut" />
        </ApexChart>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<EventTypeDistributionDto> Data { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Title { get; set; } = "Event Type Distribution";
    [Parameter] public string Subtitle { get; set; } = "Events fired by type";

    private ApexChart<EventTypeDistributionDto>? _chart;
    private ApexChartOptions<EventTypeDistributionDto> _options = default!;

    protected override void OnInitialized()
    {
        _options = new ApexChartOptions<EventTypeDistributionDto>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                FontFamily = "Inter, system-ui, sans-serif"
            },
            Colors = ["#1a4ac7", "#2cb67d", "#f59e0b", "#e04b4b", "#7a84a0"],
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    Donut = new PlotOptionsDonut
                    {
                        Size = "65%",
                        Labels = new DonutLabels
                        {
                            Show = true,
                            Total = new DonutLabelTotal
                            {
                                Show = true,
                                Label = "Total",
                                FontSize = "13px",
                                FontWeight = "600"
                        }
                    }
                }
            }
            // PlotOptions = new PlotOptions
            // {
            //     Pie = new PlotOptionsPie
            //     {
            //         Donut = new PlotOptionsPieDonut
            //         {
            //             Size = "65%",
            //             Labels = new PlotOptionsPieDonutLabels
            //             {
            //                 Show = true,
            //                 Total = new PlotOptionsPieDonutLabelsTotal
            //                 {
            //                     Show = true,
            //                     Label = "Total",
            //                     FontSize = "13px",
            //                     FontWeight = "600"
            //                 }
            //             }
            //         }
            //     }
            },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend
            {
                Position = LegendPosition.Bottom,
                HorizontalAlign = Align.Center,
                FontSize = "12px",
                ItemMargin = new LegendItemMargin { Horizontal = 8, Vertical = 4 }
            },
            Tooltip = new Tooltip
            {
                Y = new TooltipY
                {
                    Formatter = "function(val, opts) { var pct = opts.globals.seriesPercent[opts.seriesIndex][0].toFixed(1); return val.toLocaleString() + ' (' + pct + '%)'; }"
                }
            }
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart is not null && Data.Count > 0)
            await _chart.UpdateSeriesAsync(true);
    }
}