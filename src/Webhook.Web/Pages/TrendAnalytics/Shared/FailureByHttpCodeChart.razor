
@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="skeleton skeleton-chart-body"></div>
    </div>
}
else
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">Failures by HTTP Code</div>
                <div class="chart-subtitle">Distribution of non-2xx responses</div>
            </div>
        </div>
        <ApexChart TItem="FailureByCodeDto"
                   Options="_options"
                   @ref="_chart"
                   Height="220">

            <ApexPointSeries TItem="FailureByCodeDto"
                             Items="Data"
                             Name="Count"
                             XValue="d => d.CodeGroup"
                             YValue="d => d.Count"
                             SeriesType="SeriesType.Bar" />
        </ApexChart>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<FailureByCodeDto> Data { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }

    private ApexChart<FailureByCodeDto>? _chart;
    private ApexChartOptions<FailureByCodeDto> _options = default!;

    protected override void OnInitialized()
    {
        _options = new ApexChartOptions<FailureByCodeDto>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                FontFamily = "Inter, system-ui, sans-serif"
            },
            //Colors = ["#e04b4b"],
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = true,
                    BorderRadius = 4,
                    BarHeight = "60%",
                    Distributed = true
                }
            },
            Colors = ["#e04b4b", "#f59e0b", "#1a4ac7", "#7a84a0"],
            Xaxis = new XAxis
            {
                Type = XAxisType.Category,
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels { MaxWidth = 90 }
                }
            ],
            Grid = new Grid
            {
                BorderColor = "#e2e6ef",
                StrokeDashArray = 3,
                Yaxis = new GridYAxis { Lines = new Lines { Show = false } }
            },
            DataLabels = new DataLabels
            {
                Enabled = true,
                Formatter = "function(val) { return val.toLocaleString(); }",
                Style = new DataLabelsStyle { FontSize = "11px" }
            },
            Legend = new Legend { Show = false },
            Tooltip = new Tooltip
            {
                Y = new TooltipY
                {
                    Formatter = "function(val) { return val.toLocaleString() + ' failures'; }"
                }
            }
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart is not null && Data.Count > 0)
            await _chart.UpdateSeriesAsync(true);
    }
}