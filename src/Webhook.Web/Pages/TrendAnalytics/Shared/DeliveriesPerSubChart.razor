@* Components/Analytics/Charts/DeliveriesPerSubChart.razor *@
@using ApexCharts

@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="skeleton skeleton-chart-body"></div>
    </div>
}
else if (!Data.Any())
{
    <div class="chart-card">
        <div class="chart-empty">
            <div class="chart-empty-icon">📭</div>
            <div class="chart-empty-text">No delivery data</div>
            <div class="chart-empty-sub">Deliveries will appear here once your subscriptions fire.</div>
        </div>
    </div>
}
else
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">Deliveries per Subscription</div>
                <div class="chart-subtitle">Total vs failed, grouped by subscription</div>
            </div>
        </div>
        <ApexChart TItem="DeliveriesPerSubDto"
                   Options="_options"
                   @ref="_chart"
                   Height="220">

            <ApexPointSeries TItem="DeliveriesPerSubDto"
                             Items="Data"
                             Name="Total"
                             XValue="d => d.SubscriptionName"
                             YValue="d => d.Total"
                             SeriesType="SeriesType.Bar" />

            <ApexPointSeries TItem="DeliveriesPerSubDto"
                             Items="Data"
                             Name="Failed"
                             XValue="d => d.SubscriptionName"
                             YValue="d => d.Failed"
                             SeriesType="SeriesType.Bar" />
        </ApexChart>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<DeliveriesPerSubDto> Data { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }

    private ApexChart<DeliveriesPerSubDto>? _chart;
    private ApexChartOptions<DeliveriesPerSubDto> _options = default!;

    protected override void OnInitialized()
    {
        _options = new ApexChartOptions<DeliveriesPerSubDto>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                FontFamily = "Inter, system-ui, sans-serif"
            },
            Colors = ["#1a4ac7", "#e04b4b"],
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 4,
                    ColumnWidth = "55%"
                    // GroupPadding = 0.1
                }
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Category,
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false },
                Labels = new XAxisLabels
                {
                    Trim = true,
                    MaxHeight = 40
                }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(val) { return Math.round(val); }"
                    }
                }
            ],
            Grid = new Grid
            {
                BorderColor = "#e2e6ef",
                StrokeDashArray = 3,
                Xaxis = new GridXAxis { Lines = new Lines { Show = false } }
            },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend
            {
                Position = LegendPosition.Top,
                HorizontalAlign = Align.Right,
                FontSize = "12px"
            }
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart is not null && Data.Count > 0)
            await _chart.UpdateSeriesAsync(true);
    }
}