
@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="skeleton skeleton-chart-body"></div>
    </div>
}
else
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">Dead Letter Rate</div>
                <div class="chart-subtitle">Deliveries entering dead letter per day</div>
            </div>
        </div>
        <ApexChart TItem="DeadLetterRateDto"
                   Options="_options"
                   @ref="_chart"
                   Height="220">

            <ApexPointSeries TItem="DeadLetterRateDto"
                             Items="Data"
                             Name="Dead Letters"
                             XValue="d => d.Date.ToDateTime(TimeOnly.MinValue)"
                             YValue="d => d.Count"
                             SeriesType="SeriesType.Area" />
        </ApexChart>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<DeadLetterRateDto> Data { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }

    private ApexChart<DeadLetterRateDto>? _chart;
    private ApexChartOptions<DeadLetterRateDto> _options = default!;

    protected override void OnInitialized()
    {
        _options = new ApexChartOptions<DeadLetterRateDto>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false },
                FontFamily = "Inter, system-ui, sans-serif"
            },
            Colors = ["#e04b4b"],
            Fill = new Fill
            {
                Type = [FillType.Gradient],
                Gradient = new FillGradient
                {
                    ShadeIntensity = 1,
                    OpacityFrom = 0.3,
                    OpacityTo = 0.03,
                    Stops = [0, 100]
                }
            },
            Stroke = new Stroke { Curve = [Curve.Smooth], Width = [2] },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels
                {
                    DatetimeFormatter = new DatetimeFormatter { Day = "MMM dd" }
                },
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Min = 0,
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(val) { return Math.round(val); }"
                    }
                }
            ],
            Grid = new Grid
            {
                BorderColor = "#e2e6ef",
                StrokeDashArray = 3,
                Xaxis = new GridXAxis { Lines = new Lines { Show = false } }
            },
            Legend = new Legend { Show = false },
            Markers = new Markers { Size = 0, Hover = new MarkersHover(){ Size = 5, SizeOffset = 3 } }
            // Markers = new Markers { Size = 0, HoverSize = 5 },
            
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart is not null && Data.Count > 0)
            await _chart.UpdateSeriesAsync(true);
    }
}