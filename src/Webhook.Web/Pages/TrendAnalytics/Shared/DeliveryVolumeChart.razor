@using ApexCharts

@if (IsLoading)
{
    <div class="chart-card chart-card--skeleton">
        <div class="skeleton skeleton-chart-title"></div>
        <div class="skeleton skeleton-chart-body"></div>
    </div>
}
else
{
    <div class="chart-card">
        <div class="chart-head">
            <div>
                <div class="chart-title">Delivery Volume</div>
                <div class="chart-subtitle">Daily totals over the selected period</div>
            </div>
        </div>
        <ApexChart TItem="DailyVolumeDto"
                   Options="_options"
                   @ref="_chart"
                   Height="220">

            <ApexPointSeries TItem="DailyVolumeDto"
                             Items="Data"
                             Name="Total"
                             XValue="d => d.Date.ToDateTime(TimeOnly.MinValue)"
                             YValue="d => d.Total"
                             SeriesType="SeriesType.Line" />

            <ApexPointSeries TItem="DailyVolumeDto"
                             Items="Data"
                             Name="Success"
                             XValue="d => d.Date.ToDateTime(TimeOnly.MinValue)"
                             YValue="d => d.Success"
                             SeriesType="SeriesType.Line" />

            <ApexPointSeries TItem="DailyVolumeDto"
                             Items="Data"
                             Name="Failed"
                             XValue="d => d.Date.ToDateTime(TimeOnly.MinValue)"
                             YValue="d => d.Failed"
                             SeriesType="SeriesType.Line" />
        </ApexChart>
    </div>
}

@code {
    [Parameter, EditorRequired] public List<DailyVolumeDto> Data { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; }

    private ApexChart<DailyVolumeDto>? _chart;
    private ApexChartOptions<DailyVolumeDto> _options = default!;

    protected override void OnInitialized()
    {
        _options = new ApexChartOptions<DailyVolumeDto>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false },
                FontFamily = "Inter, system-ui, sans-serif"
            },
            Colors = ["#1a4ac7", "#2cb67d", "#e04b4b"],
            Stroke = new Stroke
            {
                Curve = [Curve.Smooth, Curve.Smooth, Curve.Smooth],
                Width = [2, 2, 2],
                DashArray = [0, 0, 4]
            },
            Xaxis = new XAxis
            {
                Type = XAxisType.Datetime,
                Labels = new XAxisLabels
                {
                    DatetimeFormatter = new DatetimeFormatter { Day = "MMM dd" }
                },
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false }
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(val) { return val >= 1000 ? (val/1000).toFixed(1)+'k' : val; }"
                    }
                }
            ],
            Grid = new Grid
            {
                BorderColor = "#e2e6ef",
                StrokeDashArray = 3,
                Xaxis = new GridXAxis { Lines = new Lines { Show = false } }
            },
            Legend = new Legend
            {
                Position = LegendPosition.Top,
                //HorizontalAlign = LegendHorizontalAlign.Right,
                FontSize = "12px",
                HorizontalAlign = Align.Right
            },
            Tooltip = new Tooltip
            {
                X = new TooltipX { Format = "MMM dd, yyyy" }
            },
            Markers = new Markers { Size = 0, Hover = new MarkersHover(){ Size = 5, SizeOffset = 3 } }
            // Markers = new Markers { Size = 0, HoverSize = 5 },
            
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chart is not null && Data.Count > 0)
            await _chart.UpdateSeriesAsync(true);
    }
}