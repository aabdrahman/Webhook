@page "/admin/trend/analytics"
@attribute [Authorize(Roles = "ADMIN,Admin")]

<PageTitle>Platform Analytics</PageTitle>

<div class="analytics-page">

    @* ── Top Bar ──────────────────────────────────────────── *@
    <div class="analytics-topbar">
        <div class="analytics-topbar__left">
            <h1 class="analytics-topbar__title">Analytics</h1>
            <p class="analytics-topbar__subtitle">
                Monitor webhook performance, delivery health and system activity.
            </p>
        </div>
        <DateRangeFilter ActivePeriod="DateRangeFilter.Period.Days30"
                         OnChanged="HandleDateChanged" />
    </div>

    @* ── Filter Bar ───────────────────────────────────────── *@
    <FilterBar Events="_events"
               Subscriptions="_subscriptions"
               StatusLabel="Status"
               OnApply="HandleFilterApply"
               OnReset="HandleFilterReset" />

    @* ── Page Body ────────────────────────────────────────── *@
    <div class="analytics-body">

        @* ── KPI Row ─────────────────────────────────────── *@
        <div class="analytics-kpi-grid">
            <KpiTile Label="Total Deliveries"
                     Value="148,302"
                     Icon="✈️"
                     Accent="KpiTile.KpiAccent.Blue"
                     Trend="12%"
                     TrendUp="true"
                     TrendNote="vs last 30 days"
                     IsLoading="_loading" />

            <KpiTile Label="Success Rate"
                     Value="97.4%"
                     Icon="✅"
                     Accent="KpiTile.KpiAccent.Green"
                     Trend="0.8pp"
                     TrendUp="true"
                     TrendNote="vs last 30 days"
                     IsLoading="_loading" />

            <KpiTile Label="Failed Deliveries"
                     Value="3,860"
                     Icon="⚠️"
                     Accent="KpiTile.KpiAccent.Red"
                     Trend="4%"
                     TrendUp="false"
                     TrendNote="vs last 30 days"
                     IsLoading="_loading" />

            <KpiTile Label="Dead Letters"
                     Value="1,204"
                     Icon="🔔"
                     Accent="KpiTile.KpiAccent.Amber"
                     Trend="3%"
                     TrendUp="false"
                     TrendNote="vs last 30 days"
                     IsLoading="_loading" />

            <KpiTile Label="Active Subscriptions"
                     Value="836"
                     Icon="👥"
                     Accent="KpiTile.KpiAccent.Purple"
                     Trend="+24"
                     TrendUp="true"
                     TrendNote="vs last 30 days"
                     IsLoading="_loading" />
        </div>

        @* ── Row 1: Volume + Success Rate ────────────────── *@
        <div class="analytics-panel-row">
            <DeliveryVolumeChart TotalData="_volumeTotal"
                                 SuccessfulData="_volumeSuccess"
                                 IsLoading="_loading" />

            <SuccessRateTrendChart Data="_successRate"
                                   IsLoading="_loading" />
        </div>

        @* ── Row 2: Latency + Failures by Response ───────── *@
        <div class="analytics-panel-row">
            <DeliveryLatencyCard P50Data="_latP50"
                                 P95Data="_latP95"
                                 P99Data="_latP99"
                                 IsLoading="_loading" />

            <DeliveryFailuresByResponse Items="_failuresByResponse"
                                        IsLoading="_loading" />
        </div>

        @* ── Row 3: Event Distribution + Top Failing Subs ── *@
        <div class="analytics-panel-row">
            <EventTypeDistribution Items="_eventTypes"
                                   IsLoading="_loading" />

            <TopFailingSubscriptionsTable Items="_topFailing"
                                          IsLoading="_loading" />
        </div>

        @* ── Row 4: Dead Letter Rate + Platform Health ────── *@
        <div class="analytics-panel-row">
            <DeadLetterRateCard Data="_deadLetterRate"
                                Reasons="_deadLetterReasons"
                                IsLoading="_loading" />

            <PlatformHealthCard SuccessRate="97.4m"
                                SubscriptionsWithFailures="12"
                                HighFailureCount="3"
                                DeadLetterCount="1204"
                                SuccessRateTrend="↑ 0.8pp vs last period"
                                FailuresTrend="↑ 3 vs last period"
                                HighFailureTrend="↑ 1 vs last period"
                                DeadLetterTrend="↑ 3% vs last period"
                                IsLoading="_loading" />
        </div>

        @* ── Row 5: Retry Heatmap + Tenant Leaderboard ───── *@
        <div class="analytics-panel-row">
            <RetryHeatmap Cells="_heatmapCells"
                          MonthLabels="_heatmapMonths"
                          IsLoading="_loading" />

            <TenantLeaderboard Items="_tenants"
                               IsLoading="_loading" />
        </div>

    </div>
</div>

@code {
    private bool _loading = false;

    // ── filter source lists ───────────────────────────────────
    private List<string> _events = [
        "user.created", "order.paid", "order.refunded",
        "customer.updated", "payment.failed"
    ];

    private List<string> _subscriptions = [
        "Payment Webhook", "Customer Events",
        "Order Events", "User Events", "Refund Events"
    ];

    // ── KPI / chart data ──────────────────────────────────────

    // shared label set — last 30 days
    private static readonly List<string> _days = Enumerable
        .Range(0, 30)
        .Select(i => DateTime.Today.AddDays(i - 29).ToString("M/d"))
        .ToList();

    private List<DeliveryVolumeChart.VolumePoint> _volumeTotal = _days
        .Select(d => new DeliveryVolumeChart.VolumePoint(d, Random.Shared.Next(5500, 8200)))
        .ToList();

    private List<DeliveryVolumeChart.VolumePoint> _volumeSuccess = [];

    private List<SuccessRateTrendChart.RatePoint> _successRate = _days
        .Select(d => new SuccessRateTrendChart.RatePoint(d, Math.Round((decimal)(94 + Random.Shared.NextDouble() * 4), 1)))
        .ToList();

    private List<DeliveryLatencyCard.LatencyPoint> _latP50 = _days
        .Select(d => new DeliveryLatencyCard.LatencyPoint(d, Random.Shared.Next(110, 160)))
        .ToList();

    private List<DeliveryLatencyCard.LatencyPoint> _latP95 = _days
        .Select(d => new DeliveryLatencyCard.LatencyPoint(d, Random.Shared.Next(700, 1100)))
        .ToList();

    private List<DeliveryLatencyCard.LatencyPoint> _latP99 = _days
        .Select(d => new DeliveryLatencyCard.LatencyPoint(d, Random.Shared.Next(2500, 4500)))
        .ToList();

    private List<DeliveryFailuresByResponse.FailureItem> _failuresByResponse =
    [
        new("5xx (Server Error)",  1482, 38.4m, "#ef4444"),
        new("4xx (Client Error)",   922, 23.9m, "#f59e0b"),
        new("Timeout",              613, 15.9m, "#8b5cf6"),
        new("Connection Error",     382,  9.9m, "#6366f1"),
        new("TLS / DNS Error",      231,  6.0m, "#06b6d4"),
        new("Other",                230,  6.0m, "#5a6a85"),
    ];

    private List<EventTypeDistribution.EventTypeItem> _eventTypes =
    [
        new("user.created",     28.4m, "#3b82f6"),
        new("order.paid",       22.7m, "#10b981"),
        new("order.refunded",   14.6m, "#f59e0b"),
        new("customer.updated", 12.3m, "#8b5cf6"),
        new("payment.failed",    9.8m, "#ec4899"),
        new("other",            12.2m, "#5a6a85"),
    ];

    private List<TopFailingSubscriptionsTable.FailingSubscription> _topFailing =
    [
        new("Payment Webhook", 482, 8.2m,  193, "2 min ago"),
        new("Customer Events", 321, 5.7m,  121, "8 min ago"),
        new("Order Events",    204, 4.1m,   84, "14 min ago"),
        new("User Events",     156, 3.3m,   67, "27 min ago"),
        new("Refund Events",    98, 2.1m,   41, "1 hr ago"),
    ];

    private List<DeadLetterRateCard.RatePoint> _deadLetterRate = _days
        .Select(d => new DeadLetterRateCard.RatePoint(d, Math.Round((decimal)(1.5 + Random.Shared.NextDouble() * 1.5), 2)))
        .ToList();

    private List<DeadLetterRateCard.ReasonItem> _deadLetterReasons =
    [
        new("Max retries",    61m, "#ef4444"),
        new("Permanent 4xx",  24m, "#f59e0b"),
        new("Timeouts",       11m, "#8b5cf6"),
        new("Other",           4m, "#5a6a85"),
    ];

    private List<RetryHeatmap.HeatmapCell> _heatmapCells = [];
    private List<string> _heatmapMonths = ["Mar", "Apr", "May"];

    private List<TenantLeaderboard.TenantRow> _tenants =
    [
        new("Acme Corp",        42180,  2.1m),
        new("NovaTech",         38440,  5.7m),
        new("Globex Inc",       29870,  1.2m),
        new("Initech",          18320, 11.4m),
        new("Umbrella Co",      14810,  0.8m),
        new("Massive Dynamic",   9200,  3.3m),
    ];

    // ── lifecycle ─────────────────────────────────────────────
    protected override void OnInitialized()
    {
        // derive successful volume from total
        _volumeSuccess = _volumeTotal
            .Select(p => new DeliveryVolumeChart.VolumePoint(
                p.Date,
                (int)(p.Value * (decimal)(0.94 + Random.Shared.NextDouble() * 0.04))))
            .ToList();

        // build heatmap for last 56 days
        var heatmapData = Enumerable.Range(0, 56)
            .ToDictionary(
                i => DateOnly.FromDateTime(DateTime.Today.AddDays(i - 55)),
                _ => Random.Shared.Next(0, 200));

        _heatmapCells = RetryHeatmap.BuildCells(heatmapData);
    }

    // ── event handlers ────────────────────────────────────────
    private void HandleDateChanged((DateRangeFilter.Period Period, DateOnly From, DateOnly To) args)
    {
        // TODO: reload data for the selected range
    }

    private void HandleFilterApply(FilterBar.FilterBarValues values)
    {
        // TODO: reload data filtered by Event, Subscription, Status
    }

    private void HandleFilterReset()
    {
        // TODO: reload unfiltered data
    }
}
