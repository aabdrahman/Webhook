@page "/change-password"

<PageTitle>Change Password — WebhookHub</PageTitle>

<PageSpinner Visible="@_isInitializing" Label="Loading..." />

@if (!_isInitializing)
{
    @if (_tokenMissing)
    {
        <div style="max-width:480px;margin:var(--space-12) auto;">
            <Alert Type="error"
                   Title="Session expired"
                   Message="Your password change session has expired. Please request a new OTP." />
            <div style="margin-top:var(--space-4);">
                <a href="/request-otp?purpose=ChangePassword&returnUrl=/change-password"
                   class="btn btn-primary">
                    Request OTP
                </a>
            </div>
        </div>
    }
    else
    {
        <PageHeader Title="Change Password"
                    Description="Enter your current password and choose a new one." />

        <div style="max-width:520px;">
            <div class="card">
                <div class="card-body">

                    <Alert Type="success"
                           Message="@_successMessage"
                           Visible="@(!string.IsNullOrWhiteSpace(_successMessage))" />

                    <Alert Message="@_errorMessage" />

                    <EditForm Model="_model"
                              OnValidSubmit="HandleChangePassword">

                        <DataAnnotationsValidator />

                        <div style="display:flex;flex-direction:column;
                                    gap:var(--space-5);">

                            <!-- Current password -->
                            <div class="form-group">
                                <label class="form-label form-label-required"
                                       for="currentPassword">
                                    Current password
                                </label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon-left"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11"
                                              rx="2" ry="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    <input id="currentPassword"
                                           type="@(_showCurrent ? "text" : "password")"
                                           class="form-input has-icon-left has-icon-right"
                                           placeholder="••••••••••"
                                           @bind="_model.CurrentPassword"
                                           @bind:event="oninput"
                                           @onblur="HideCurrentOnBlur"
                                           autocomplete="current-password"
                                           disabled="@_isSubmitting" />
                                    <button type="button"
                                            class="form-input-icon-right"
                                            @onmousedown:preventDefault
                                            @onclick="() => _showCurrent = !_showCurrent"
                                            tabindex="-1">
                                        @if (_showCurrent)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17.94 17.94A10.07 10.07 0 0 1
                                                         12 20c-7 0-11-8-11-8a18.45 18.45
                                                         0 0 1 5.06-5.94" />
                                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12
                                                         4c7 0 11 8 11 8a18.5 18.5 0 0
                                                         1-2.16 3.19" />
                                                <line x1="1" y1="1" x2="23" y2="23" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11
                                                         8-4 8-11 8-11-8-11-8z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        }
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => _model.CurrentPassword)"
                                                   class="form-error" />
                            </div>

                            <!-- New password -->
                            <div class="form-group">
                                <label class="form-label form-label-required"
                                       for="newPassword">
                                    New password
                                </label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon-left"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11"
                                              rx="2" ry="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    <input id="newPassword"
                                           type="@(_showNew ? "text" : "password")"
                                           class="form-input has-icon-left has-icon-right"
                                           placeholder="••••••••••"
                                           @bind="_model.NewPassword"
                                           @bind:event="oninput"
                                           @onblur="HideNewOnBlur"
                                           autocomplete="new-password"
                                           disabled="@_isSubmitting" />
                                    <button type="button"
                                            class="form-input-icon-right"
                                            @onmousedown:preventDefault
                                            @onclick="() => _showNew = !_showNew"
                                            tabindex="-1">
                                        @if (_showNew)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17.94 17.94A10.07 10.07 0 0 1
                                                         12 20c-7 0-11-8-11-8a18.45 18.45
                                                         0 0 1 5.06-5.94" />
                                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12
                                                         4c7 0 11 8 11 8a18.5 18.5 0 0
                                                         1-2.16 3.19" />
                                                <line x1="1" y1="1" x2="23" y2="23" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11
                                                         8-4 8-11 8-11-8-11-8z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        }
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => _model.NewPassword)"
                                                   class="form-error" />

                                <!-- Strength indicator -->
                                @if (!string.IsNullOrWhiteSpace(_model.NewPassword))
                                {
                                    <div class="password-strength">
                                        <div class="password-strength-bars">
                                            <div class="password-strength-bar
                                                @(_strength >= 1 ? StrengthClass : "")">
                                            </div>
                                            <div class="password-strength-bar
                                                @(_strength >= 2 ? StrengthClass : "")">
                                            </div>
                                            <div class="password-strength-bar
                                                @(_strength >= 3 ? StrengthClass : "")">
                                            </div>
                                        </div>
                                        <span class="password-strength-label @StrengthClass">
                                            @StrengthLabel
                                        </span>
                                    </div>
                                }
                            </div>

                            <!-- Confirm password -->
                            <div class="form-group">
                                <label class="form-label form-label-required"
                                       for="confirmPassword">
                                    Confirm new password
                                </label>
                                <div class="form-input-wrapper">
                                    <svg class="form-input-icon-left"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2"
                                         stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11"
                                              rx="2" ry="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                    <input id="confirmPassword"
                                           type="@(_showConfirm ? "text" : "password")"
                                           class="form-input has-icon-left has-icon-right"
                                           placeholder="••••••••••"
                                           @bind="_model.ConfirmPassword"
                                           @bind:event="oninput"
                                           @onblur="HideConfirmOnBlur"
                                           autocomplete="new-password"
                                           disabled="@_isSubmitting" />
                                    <button type="button"
                                            class="form-input-icon-right"
                                            @onmousedown:preventDefault
                                            @onclick="() => _showConfirm = !_showConfirm"
                                            tabindex="-1">
                                        @if (_showConfirm)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17.94 17.94A10.07 10.07 0 0 1
                                                         12 20c-7 0-11-8-11-8a18.45 18.45
                                                         0 0 1 5.06-5.94" />
                                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12
                                                         4c7 0 11 8 11 8a18.5 18.5 0 0
                                                         1-2.16 3.19" />
                                                <line x1="1" y1="1" x2="23" y2="23" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11
                                                         8-4 8-11 8-11-8-11-8z" />
                                                <circle cx="12" cy="12" r="3" />
                                            </svg>
                                        }
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => _model.ConfirmPassword)"
                                                   class="form-error" />
                            </div>

                            <LoadingButton Text="Change Password"
                                           LoadingText="Changing..."
                                           IsLoading="@_isSubmitting"
                                           FullWidth="true"
                                           Type="submit" />

                        </div>

                    </EditForm>
                </div>
            </div>
        </div>
    }
}

@code {

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool   _isInitializing = true;
    private bool   _isSubmitting   = false;
    private bool   _tokenMissing   = false;
    private string _errorMessage   = string.Empty;
    private string _successMessage = string.Empty;

    // Password visibility
    private bool _showCurrent = false;
    private bool _showNew     = false;
    private bool _showConfirm = false;

    private readonly ChangePasswordModel _model = new();

    // -------------------------------------------------------------------------
    // Password strength
    // -------------------------------------------------------------------------

    private int _strength => ComputeStrength(_model.NewPassword);

    private string StrengthClass => _strength switch
    {
        1 => "weak",
        2 => "medium",
        3 => "strong",
        _ => ""
    };

    private string StrengthLabel => _strength switch
    {
        1 => "Weak",
        2 => "Medium",
        3 => "Strong",
        _ => ""
    };

    private static int ComputeStrength(string password)
    {
        if (string.IsNullOrWhiteSpace(password)) return 0;
        int score = 0;
        if (password.Length >= 10)                                     score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(char.IsDigit) || password.Any(c =>
            !char.IsLetterOrDigit(c)))                                 score++;
        return score;
    }

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        // TODO: check operation token exists in localStorage
        // var token = await LocalStorage.GetItemAsync<string>("operation_token");
        // _tokenMissing = string.IsNullOrWhiteSpace(token);

        await Task.Delay(300);
        _tokenMissing   = false;
        _isInitializing = false;
    }

    // -------------------------------------------------------------------------
    // Password visibility
    // -------------------------------------------------------------------------

    private async Task HideCurrentOnBlur()
    {
        await Task.Delay(150);
        _showCurrent = false;
    }

    private async Task HideNewOnBlur()
    {
        await Task.Delay(150);
        _showNew = false;
    }

    private async Task HideConfirmOnBlur()
    {
        await Task.Delay(150);
        _showConfirm = false;
    }

    // -------------------------------------------------------------------------
    // Handler
    // -------------------------------------------------------------------------

    private async Task HandleChangePassword()
    {
        _errorMessage  = string.Empty;
        _successMessage = string.Empty;
        _isSubmitting  = true;

        try
        {
            // TODO: replace with real service call
            // var token  = await LocalStorage.GetItemAsync<string>("operation_token");
            // var result = await AuthService.ChangePasswordAsync(new ChangePasswordDto
            // {
            //     OperationToken  = token,
            //     CurrentPassword = _model.CurrentPassword,
            //     NewPassword     = _model.NewPassword,
            //     ConfirmPassword = _model.ConfirmPassword
            // });
            //
            // if (!result.IsSuccessful)
            // {
            //     _errorMessage = result.ResponseMessage;
            //     return;
            // }
            //
            // await LocalStorage.RemoveItemAsync("operation_token");

            await Task.Delay(800);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _errorMessage = "Failed to change password. Please try again.";
                return;
            }

            _successMessage = "Password changed successfully.";
            _model.CurrentPassword = string.Empty;
            _model.NewPassword     = string.Empty;
            _model.ConfirmPassword = string.Empty;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // -------------------------------------------------------------------------
    // Local model
    // -------------------------------------------------------------------------

    private sealed class ChangePasswordModel
    {
        [Required(ErrorMessage = "Current password is required.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "New password is required.")]
        [MinLength(10, ErrorMessage = "Password must be at least 10 characters.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
