@page "/"
@using Webhook.Web.Components

@inject Helper.EnvironmentVariables environmentVariable

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@if (_isLoading)
{
    <CardSkeleton />
}
else
{
    <p>AppBaseUrl: @_configValue</p>
    <p>ApiTimeOutInSeconds: @_timeout</p>
}


@code {

    private string? _configValue;
    private int _timeout = 0;
    private bool _isLoading = true;

    protected override void OnInitialized()
    {
        _configValue = environmentVariable.AppBaseUrl;
        _timeout = environmentVariable.ApiTimeOutInSeconds;

        Console.WriteLine($"AppBaseUrl: {_configValue}");
        Console.WriteLine($"ApiTimeOutInSeconds: {_timeout}");
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(10000);
        _isLoading = false;
    }



}