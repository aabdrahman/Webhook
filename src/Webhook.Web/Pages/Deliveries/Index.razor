@page "/deliveries/{SubscriptionId:guid?}"
@attribute [Authorize]

<PageTitle>Deliveries — WebhookHub</PageTitle>

<PageSpinner Visible="@_isLoading" Label="Loading deliveries..." />

@if (!_isLoading)
{
    <PageHeader Title="Deliveries"
                Description="View and manage webhook delivery history." />

    <!-- Filters -->
    <div class="card" style="margin-bottom:var(--space-5);">
        <div class="card-body" style="display:flex;gap:0.5rem;flex-direction:column;">
            <div class="deliveries-filters">

                <!-- Page Number -->
                <div class="form-group">
                    <label class="form-label" for="pagenumber">Page Number</label>
                    <input id="pagenumber"
                           type="number"
                           class="form-input"
                           @bind="_requestQueryParameter.PageNumber"/>
                </div>

                <!-- Page Size -->
                <div class="form-group">
                    <label class="form-label" for="pagesize">Page Size</label>
                    <input id="pagesize"
                           type="number"
                           min="1"
                           class="form-input"
                           @bind="_requestQueryParameter.PageSize"/>
                </div>

                <!-- Status filter -->
                <div class="form-group">
                    <label class="form-label" for="statusFilter">Status</label>
                    <select id="statusFilter"
                            class="form-select"
                            @bind="_requestQueryParameter.DeliveryStatus">
                        <option value="">All statuses</option>
                        @foreach (var item in Enum.GetValues<WebhookDeliveryStatus>())
                        {
                            <option value="@item">@item</option>
                        }
                    </select>
                </div>

                <!-- Date from -->
                <div class="form-group">
                    <label class="form-label" for="dateFrom">From</label>
                    <input id="dateFrom"
                           type="date"
                           class="form-input"
                           @bind="_requestQueryParameter.StartDate"/>
                    @if (!string.IsNullOrWhiteSpace(_dateFromError))
                    {
                        <span class="form-error">@_dateFromError</span>
                    }
                </div>

                <!-- Date to -->
                <div class="form-group">
                    <label class="form-label" for="dateTo">To</label>
                    <input id="dateTo"
                           type="date"
                           class="form-input"
                           @bind="_requestQueryParameter.EndDate"/>
                    @if (!string.IsNullOrWhiteSpace(_dateToError))
                    {
                        <span class="form-error">@_dateToError</span>
                    }
                </div>

                <!-- Apply filters -->
                <div class="form-group" style="justify-content:center;align-items:center;">
                    <label class="form-label" style="visibility:hidden;">apply</label>
                    <button class="btn btn-primary btn-sm"
                            @onclick="ApplyFilters">
                        Apply filters
                    </button>
                </div>

                <!-- Clear filters -->
                <div class="form-group" style="justify-content:center;align-items:center;">
                    <label class="form-label" style="visibility:hidden;">clear</label>
                    <button class="btn btn-ghost btn-sm"
                            @onclick="ClearFilters">
                        Clear filters
                    </button>
                </div>
            </div>
            <Alert Message="@_filterErrorMessage" />
        </div>
    </div>

    <!-- Error -->
    <Alert Message="@_errorMessage" />

    <!-- Table -->
    @if (_isFiltering)
    {
        <TableSkeleton Rows="8" Columns="6" />
    }
    else if (!_deliveries.Any())
    {
        <EmptyState Title="No deliveries found"
                    Description="No deliveries match your current filters."
                    Icon="delivery" />
    }
    else
    {
        <div class="card">
            <div class="card-body" style="padding:0;">
                <div class="table-wrapper" style="border:none;border-radius:0;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Event Type</th>
                                <th>Subscription</th>
                                <th>Status</th>
                                <th>Duration</th>
                                <th>Retry Count</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var delivery in _deliveries)
                            {
                                <tr class="table-row-clickable"
                                    @onclick="() => NavigateToAttempts(delivery.Id)">
                                    <td class="table-mono text-sm">
                                        @delivery.EventType
                                    </td>
                                    <td class="text-sm">
                                        @delivery.SubscriptionName
                                    </td>
                                    <td>
                                        <Badge Value="@delivery.Status"
                                               Variant="delivery" />
                                    </td>
                                    <td class="text-sm text-muted">
                                        @(delivery.DurationMs > 0 ? $"{delivery.DurationMs.ToString("F2")} ms" : "—")
                                    </td>
                                    <td class="text-sm text-muted">
                                        @delivery.RetryCount
                                    </td>
                                    <td class="text-sm text-muted">
                                        @delivery.CreatedAt.ToString("MMM dd, HH:mm")
                                    </td>
                                    <td @onclick:stopPropagation="true">
                                        @if (delivery.Status == "DeadLetter")
                                        {
                                            <button class="btn btn-outline btn-sm"
                                                    @onclick="() => OpenRetryModal(delivery)"
                                                    title="Manual retry">
                                                <svg viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round"
                                                     style="width:13px;height:13px;">
                                                    <polyline points="23 4 23 10 17 10" />
                                                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                                                </svg>
                                                Retry
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination — commented out until ready -->
                @if(_responseMetaData is not null)
                {
                    <div class="deliveries-pagination">
                        <span class="text-sm text-secondary">
                            Page @_currentPage of @_totalPages
                        </span>
                        <div class="pagination">
                            <button class="pagination-btn"
                                    disabled="@(!_responseMetaData.hasPrevious)"
                                    @onclick="PreviousPage">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     style="width:14px;height:14px;">
                                    <polyline points="15 18 9 12 15 6" />
                                </svg>
                            </button>
                            @for (int p = 1; p <= _responseMetaData.totalPages; p++)
                            {
                                int currPage = p;
                                <button class="pagination-btn @(_currentPage == currPage ? "active" : "")"
                                        @onclick="() => GoToPage(currPage)">
                                    @currPage
                                </button>
                            }
                            <button class="pagination-btn"
                                    disabled="@(!_responseMetaData.hasNext)"
                                    @onclick="NextPage">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     style="width:14px;height:14px;">
                                    <polyline points="9 18 15 12 9 6" />
                                </svg>
                            </button>
                        </div>
                    </div>
                }
                
            </div>
        </div>
    }
}

<!-- Manual retry modal -->
@if (_selectedDelivery is not null)
{
    <Modal @bind-IsOpen="_showRetryModal"
           Title="Manual Retry"
           ConfirmText="Retry Delivery"
           ConfirmVariant="primary"
           IsConfirming="@_isRetrying"
           OnConfirm="HandleRetry"
           OnClose="CloseModals">

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Event Type</span>
                <span class="subscription-modal-value table-mono">
                    @_selectedDelivery.EventType
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Subscription</span>
                <span class="subscription-modal-value">
                    @_selectedDelivery.SubscriptionName
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Status</span>
                <Badge Value="@_selectedDelivery.Status" Variant="delivery" />
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Retry Count</span>
                <span class="subscription-modal-value">
                    @_selectedDelivery.RetryCount
                </span>
            </div>
        </div>

        <Alert Type="info"
               Message="This will re-queue the delivery for processing. The retry count will be incremented." />

        <Alert Message="@_retryErrorMessage" />

    </Modal>
}

@code {

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------
    [Parameter]
    public Guid? SubscriptionId { get; set; } = null;

    private bool   _isLoading   = true;
    private bool   _isFiltering = false;
    private string _errorMessage = string.Empty;
    private WebhookDeliveryQueryRequestParameter _requestQueryParameter = new();
    private Guid? _subscriptionId = null;
    private RequestMetaData? _responseMetaData = null;


    // Filters
    private string   _filterSubscriptionId = string.Empty;
    private string   _filterStatus         = string.Empty;
    private DateTime? _filterDateFrom      = null;
    private DateTime? _filterDateTo        = null;
    private string _dateFromError = string.Empty;
    private string _dateToError = string.Empty;
    private string _filterErrorMessage = string.Empty;

    // Data
    private List<DeliveryItem>       _deliveries    = [];
    private List<SubscriptionOption> _subscriptions = [];

    // Retry modal
    private bool         _showRetryModal    = false;
    private bool         _isRetrying        = false;
    private string       _retryErrorMessage = string.Empty;
    private DeliveryItem? _selectedDelivery;

    // Pagination state — ready for when pagination is enabled
    private int _currentPage = 1;
    private int _pageSize    = 20;
    private int _totalPages  = 1;

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        // Read subscriptionId query param and pre-apply filter
        var uri   = new Uri(navigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("subscriptionId", out var subId)
            && !string.IsNullOrWhiteSpace(subId))
        {
            _filterSubscriptionId = subId.ToString();
            if(Guid.TryParse(subId, out var subscriptionId))
            {
                _subscriptionId = subscriptionId;
                _requestQueryParameter.SubscriptionId = subscriptionId;
            }

        }


    }

    protected override async Task OnParametersSetAsync()
    {
        if(SubscriptionId is not null)
        {
            _requestQueryParameter.SubscriptionId = SubscriptionId.Value;
        }

        await LoadDeliveriesAsync();
    }

    private async Task LoadDeliveriesAsync()
    {
        _errorMessage = string.Empty;

        try
        {

            await Task.Delay(800);
            var result = await getDeliveriesHandler.HandleAsync(_requestQueryParameter);
            bool success = result.details.IsSuccessful;
            //bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _errorMessage = $"Failed to load deliveries. {result.details.ResponseMessage}";
                _deliveries = [];
                _responseMetaData = null;
                return;
            }

            if(result.details.ResponseData is null)
            {
                _errorMessage = $"Failed to load deliveries. {result.details.ResponseMessage}";
                _deliveries = [];
                _responseMetaData = null;
                return;
            }

            _deliveries = result.details.ResponseData
                                .Select(x => new DeliveryItem(Id: x.Id, EventType: x.EventType, SubscriptionName: x.SubscriberName, Status: x.Status.ToString(), DurationMs: x.AverageDuration.HasValue ? x.AverageDuration.Value : 0, RetryCount: x.RetryCount, CreatedAt: x.CreatedAt))
                                .ToList();
            _responseMetaData = result.metaData;

            // _deliveries =
            // [
            //     new(Guid.NewGuid(), "OrderCreated",    "Order Service Sub", "Delivered",  142,  0, DateTimeOffset.UtcNow.AddMinutes(-2)),
            //     new(Guid.NewGuid(), "PaymentReceived", "CRM Sub",           "Failed",     3012, 3, DateTimeOffset.UtcNow.AddMinutes(-8)),
            //     new(Guid.NewGuid(), "OrderCancelled",  "Order Service Sub", "DeadLetter", 0,    5, DateTimeOffset.UtcNow.AddMinutes(-20)),
            //     new(Guid.NewGuid(), "UserRegistered",  "Notification Sub",  "Pending",    0,    0, DateTimeOffset.UtcNow.AddMinutes(-1)),
            //     new(Guid.NewGuid(), "OrderCreated",    "Order Service Sub", "Delivered",  201,  0, DateTimeOffset.UtcNow.AddMinutes(-35)),
            // ];
        }
        finally
        {
            _isLoading = false;
            _isFiltering = false;
        }
    }

    // -------------------------------------------------------------------------
    // Filters
    // -------------------------------------------------------------------------

    private async Task ApplyFilters()
    {
        _isFiltering  = true;
        _errorMessage = string.Empty;
        _filterErrorMessage = string.Empty;

        if(_requestQueryParameter.StartDate > _requestQueryParameter.EndDate)
        {
            _filterErrorMessage = "Start Date cannot be earlier than the end date.";
            return;
        }

        if(_requestQueryParameter.PageSize > 100)
        {
            _filterErrorMessage = $"The page size cannot exceed 100.";
            return;
        }

        if(_requestQueryParameter.PageNumber < 1)
        {
            _filterErrorMessage = "Page Number cannot be less than 1.";
            return;
        }

        if (_requestQueryParameter.PageSize < 1)
        {
            _filterErrorMessage = "Page Size cannot be less than 1.";
            return;
        }

        try
        {
            await LoadDeliveriesAsync();
        }
        finally
        {
            _isFiltering = false;
        }
    }

    private async Task ClearFilters()
    {
        _filterErrorMessage = string.Empty;
        _filterSubscriptionId = string.Empty;
        _filterStatus         = string.Empty;
        _filterDateFrom       = null;
        _filterDateTo         = null;
        _requestQueryParameter = new();


        if(_subscriptionId.HasValue)
        {
            _requestQueryParameter.SubscriptionId = _subscriptionId;
        }
        await ApplyFilters();
    }

    // -------------------------------------------------------------------------
    // Pagination — ready for when enabled
    // -------------------------------------------------------------------------

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadDeliveriesAsync();
    }

    private async Task PreviousPage()
    {
        if (_currentPage > 1)
        {
            _requestQueryParameter.PageNumber = _currentPage - 1;
        }
        await GoToPage(_currentPage - 1);
    }

    private async Task NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _requestQueryParameter.PageNumber = _currentPage + 1;
        }
        await GoToPage(_currentPage + 1);
    }

    // -------------------------------------------------------------------------
    // Navigation
    // -------------------------------------------------------------------------

    private void NavigateToAttempts(Guid deliveryId)
        => navigationManager.NavigateTo($"/deliveries/{deliveryId}/attempts");

    // -------------------------------------------------------------------------
    // Retry modal
    // -------------------------------------------------------------------------

    private void OpenRetryModal1(DeliveryItem delivery)
    {
        _selectedDelivery  = delivery;
        navigationManager.NavigateTo($"/dead-letters/{_selectedDelivery.Id}");
        _retryErrorMessage = string.Empty;
        _showRetryModal    = true;
    }

    private void OpenRetryModal(DeliveryItem delivery)
    {
        _selectedDelivery = delivery;
        navigationManager.NavigateTo($"/dead-letters/{_selectedDelivery.Id}");
        // _retryErrorMessage = string.Empty;
        // _showRetryModal = true;
    }

    private void CloseModals()
    {
        _showRetryModal   = false;
        _selectedDelivery = null;
        _retryErrorMessage = string.Empty;
    }

    private async Task HandleRetry()
    {
        if (_selectedDelivery is null) return;

        _retryErrorMessage = string.Empty;
        _isRetrying        = true;

        try
        {
            await Task.Delay(800);
            //var result = await requestDeadLetterDeliveryRetryHandler.HandleAsync(_selectedDelivery.Id, new RequestManualRetryDto(){  })

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _retryErrorMessage = "Failed to retry delivery. Please try again.";
                return;
            }

            toastService.ShowSuccess("Delivery queued for retry successfully.");
            CloseModals();
            await LoadDeliveriesAsync();
        }
        finally
        {
            _isRetrying = false;
        }
    }

    // -------------------------------------------------------------------------
    // Local view models
    // -------------------------------------------------------------------------

    private sealed record DeliveryItem(
        Guid           Id,
        string         EventType,
        string         SubscriptionName,
        string         Status,
        double            DurationMs,
        int            RetryCount,
        DateTimeOffset CreatedAt);

    private sealed record SubscriptionOption(
        string Id,
        string Name);
}
