
@attribute [Authorize]
@page "/deliveries/{DeliveryId:guid}/attempts"

<PageTitle>Delivery Attempts — WebhookHub</PageTitle>

<PageSpinner Visible="@_isLoading" Label="Loading delivery attempts..." />

@if (!_isLoading)
{
    <div class="attempts-header">
        <button class="btn btn-ghost btn-sm"
                @onclick="@(() => navigationManager.NavigateTo("/deliveries"))">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 style="width:14px;height:14px;">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Back to Deliveries
        </button>
    </div>

    <PageHeader Title="Delivery Attempts"
                Description="@($"Delivery ID: {DeliveryId}")" />

    <!-- Delivery details card -->
    @if (_delivery is not null)
    {
        <div class="card" style="margin-bottom:var(--space-5);">
            <div class="card-header">
                <h2 class="card-title">Delivery Details</h2>
                <Badge Value="@_delivery.Status" Variant="delivery" />
            </div>
            <div class="card-body">

                <!-- Row 1 — core fields -->
                <div class="attempts-summary-grid" style="margin-bottom:var(--space-5);">
                    <div class="detail-field">
                        <span class="detail-field-label">Event Type</span>
                        <span class="detail-field-value table-mono text-sm">
                            @_delivery.EventType
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Subscriber</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.SubscriberName
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Retry Cycle</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.RetryCycle
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Retry Count</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.RetryCount
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Total Attempts</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.TotalAttempts
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Failed Attempts</span>
                        <span class="detail-field-value text-sm"
                              style="color:@(_delivery.TotalFailedAttempts > 0
                                             ? "var(--color-danger)"
                                             : "inherit");">
                            @_delivery.TotalFailedAttempts
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Avg Duration</span>
                        <span class="detail-field-value text-sm">
                            @(_delivery.AverageDuration.HasValue
                                ? $"{_delivery.AverageDuration:F1} ms"
                                : "—")
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Created</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")
                        </span>
                    </div>
                    @if (_delivery.DeliveredAt.HasValue)
                    {
                        <div class="detail-field">
                            <span class="detail-field-label">Delivered At</span>
                            <span class="detail-field-value text-sm"
                                  style="color:var(--color-success);">
                                @_delivery.DeliveredAt.Value.ToString("MMM dd, yyyy HH:mm:ss")
                            </span>
                        </div>
                    }
                    @if (_delivery.NextRetryAt.HasValue)
                    {
                        <div class="detail-field">
                            <span class="detail-field-label">Next Retry</span>
                            <span class="detail-field-value text-sm"
                                  style="color:var(--color-warning);">
                                @_delivery.NextRetryAt.Value.ToString("MMM dd, yyyy HH:mm:ss")
                            </span>
                        </div>
                    }
                </div>

                <!-- Callback URL -->
                @if (!string.IsNullOrWhiteSpace(_delivery.CallBackUrl))
                {
                    <div class="detail-field" style="margin-bottom:var(--space-4);">
                        <span class="detail-field-label">Callback URL</span>
                        <span class="detail-field-value table-mono text-sm">
                            @_delivery.CallBackUrl
                        </span>
                    </div>
                }

                <!-- Request payload -->
                @if (!string.IsNullOrWhiteSpace(_delivery.RequestPayload))
                {
                    <div class="detail-field">
                        <div class="attempts-response-header">
                            <span class="detail-field-label">Request Payload</span>
                            <CopyButton Value="@_delivery.RequestPayload"
                                        ShowField="false"
                                        Label="Copy payload" />
                        </div>
                        <pre class="attempts-response-pre"
                             style="margin-top:var(--space-2);">@FormatJson(_delivery.RequestPayload)</pre>
                    </div>
                }

            </div>
        </div>
    }

    <Alert Message="@_errorMessage" />

    @if (_isLoadingAttempts)
    {
        <TableSkeleton Rows="4" Columns="4" />
    }
    else if (!_attempts.Any() && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <EmptyState Title="No attempts yet"
                    Description="@(string.Concat("No delivery attempts have been made for this delivery. ", _loadAttempsErrorMessage))"
                    Icon="delivery" />
    }
    else
    {
        <div class="attempts-list">
            @foreach (var attempt in _attempts.OrderByDescending(a => a.AttemptedAt))
            {
                <div class="card attempts-card">
                    <div class="card-header">
                        <div class="attempts-card-title">
                            <div class="attempts-card-number">
                                #@attempt.AttemptedCount
                            </div>
                            <div class="attempts-card-meta">
                                <span class="attempts-status-code
                                      @(IsSuccessCode(attempt.HttpResponseCode)
                                          ? "attempts-status-success"
                                          : "attempts-status-error")">
                                    @attempt.HttpResponseCode
                                </span>
                                <span class="text-sm text-muted">
                                    @attempt.Duration ms
                                </span>
                            </div>
                        </div>
                        <div class="attempts-card-time">
                            <span class="text-sm text-muted">
                                @attempt.AttemptedAt.ToString("MMM dd, yyyy HH:mm:ss")
                            </span>
                            <button class="btn btn-ghost btn-sm"
                                    @onclick="() => ToggleExpand(attempt.Id)"
                                    title="@(_expandedIds.Contains(attempt.Id)
                                             ? "Collapse" : "Expand")">
                                <svg viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     style="width:14px;height:14px;
                                            transform:@(_expandedIds.Contains(attempt.Id)
                                                ? "rotate(180deg)" : "rotate(0deg)");
                                            transition:transform 0.2s ease;">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    @if (_expandedIds.Contains(attempt.Id))
                    {
                        <div class="card-body attempts-response-body">
                            <div class="attempts-response-header">
                                <span class="detail-field-label">HTTP Response</span>
                                <CopyButton Value="@attempt.HttpResponse"
                                            ShowField="false"
                                            Label="Copy response" />
                            </div>
                            @if (string.IsNullOrWhiteSpace(attempt.HttpResponse))
                            {
                                <p class="text-sm text-muted">No response body.</p>
                            }
                            else
                            {
                                <pre class="attempts-response-pre">
                                    @FormatJson(attempt.HttpResponse)
                                </pre>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {

    [Parameter] public Guid DeliveryId { get; set; }

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool                       _isLoading    = true;
    private string                     _errorMessage = string.Empty;
    private WebhookDeliveryDetailsDto? _delivery;
    private List<AttemptItem>          _attempts     = [];
    private HashSet<Guid>              _expandedIds  = [];
    private bool _isLoadingAttempts = false;
    private string _loadAttempsErrorMessage = string.Empty;

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
        => await LoadAttemptsAsync();

    private async Task LoadAttemptsAsync()
    {
        _isLoading    = true;
        _errorMessage = string.Empty;

        try
        {

            await Task.Delay(700);
            var result = await getDeliveryDetailsHandler.HandleAsync(deliveryId: DeliveryId);
            //bool success = DateTimeOffset.UtcNow.Second % 2 == 0;
            bool success = result.response.successStatus;
            if (!success)
            {
                _errorMessage = $"Failed to load delivery attempts. {result.response.responseMessage}";
                return;
            }

            if(result.deliveryDetails is null)
            {
                _errorMessage = $"Failed to load delivery attempts. {result.response.responseMessage}";
                return;
            }

            _delivery = result.deliveryDetails;

            // _delivery = new WebhookDeliveryDetailsDto
            // {
            //     Id                  = DeliveryId,
            //     SubscriberName      = "Order Service Sub",
            //     EventType           = "OrderCreated",
            //     Status              = "Failed",
            //     RetryCycle          = 2,
            //     RetryCount          = 3,
            //     AverageDuration     = 3604.6,
            //     TotalAttempts       = 3,
            //     TotalFailedAttempts = 3,
            //     RequestPayload      = @"{""orderId"":""abc-123"",""amount"":5000,""currency"":""NGN""}",
            //     CallBackUrl         = "https:orders.internal/webhook",
            //     NextRetryAt         = DateTimeOffset.UtcNow.AddMinutes(15),
            //     DeliveredAt         = null,
            //     CreatedAt           = DateTimeOffset.UtcNow.AddMinutes(-30)
            // };


            if(_delivery is not null)
            {
                _isLoadingAttempts = true;
                _isLoading = false;
                var getDeliveryAttemptsResult = await getDeliveryAttemptsHandler.HandleAsync(deliveryId: DeliveryId);

                if (!getDeliveryAttemptsResult.response.successStatus)
                {
                    _loadAttempsErrorMessage = getDeliveryAttemptsResult.response.responseMessage;
                    _isLoadingAttempts = false;
                    return;
                }

                if (!getDeliveryAttemptsResult.deliveryAttempts.Any())
                {
                    _loadAttempsErrorMessage = getDeliveryAttemptsResult.response.responseMessage;
                    _isLoadingAttempts = false;
                    return;
                }

                _attempts = getDeliveryAttemptsResult.deliveryAttempts.Select(x => new AttemptItem(Id: Guid.NewGuid(), HttpResponseCode: x.HttpStatusCode, HttpResponse: x.HttpResponse, Duration: x.HttpDuration, AttemptedAt: x.AttemptedAt, AttemptedCount: 1)).ToList();
            }

            // _attempts =
            // [
            //     new AttemptItem(
            //         Guid.NewGuid(), "500",
            //         @"{""error"":""Internal Server Error"",""message"":""Database connection failed.""}",
            //         3012.5, DateTimeOffset.UtcNow.AddMinutes(-30), 1),

            //     new AttemptItem(
            //         Guid.NewGuid(), "503",
            //         @"{""error"":""Service Unavailable""}",
            //         5001.2, DateTimeOffset.UtcNow.AddMinutes(-20), 2),

            //     new AttemptItem(
            //         Guid.NewGuid(), "500",
            //         @"{""error"":""Internal Server Error""}",
            //         2800.1, DateTimeOffset.UtcNow.AddMinutes(-10), 3),
            // ];
        }
        finally
        {
            _isLoading = false;
            _isLoadingAttempts = false;
        }
    }

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    private void ToggleExpand(Guid id)
    {
        if (_expandedIds.Contains(id))
            _expandedIds.Remove(id);
        else
            _expandedIds.Add(id);
    }

    private static bool IsSuccessCode(string code)
    {
        if (int.TryParse(code, out int status))
            return status >= 200 && status < 300;
        return false;
    }

    private static string FormatJson(string json)
    {
        try
        {
            var parsed = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(parsed.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    // -------------------------------------------------------------------------
    // Local view model — attempts only
    // -------------------------------------------------------------------------

    private sealed record AttemptItem(
        Guid           Id,
        string         HttpResponseCode,
        string         HttpResponse,
        double         Duration,
        DateTimeOffset AttemptedAt,
        int            AttemptedCount);
}
