@page "/deliveries/{DeliveryId:guid}/attempts"
@inject NavigationManager Navigation

<PageTitle>Delivery Attempts — WebhookHub</PageTitle>

<PageSpinner Visible="@_isLoading" Label="Loading delivery attempts..." />

@if (!_isLoading)
{
    <div class="attempts-header">
        <button class="btn btn-ghost btn-sm"
                @onclick="NavigateBack">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 style="width:14px;height:14px;">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Back to Deliveries
        </button>
    </div>

    <PageHeader Title="Delivery Attempts"
                Description="@($"Delivery ID: {DeliveryId}")" />

    <!-- Delivery summary card -->
    @if (_delivery is not null)
    {
        <div class="card" style="margin-bottom:var(--space-5);">
            <div class="card-header">
                <h2 class="card-title">Delivery Summary</h2>
                <Badge Value="@_delivery.Status" Variant="delivery" />
            </div>
            <div class="card-body">
                <div class="attempts-summary-grid">
                    <div class="detail-field">
                        <span class="detail-field-label">Event Type</span>
                        <span class="detail-field-value table-mono text-sm">
                            @_delivery.EventType
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Subscription</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.SubscriptionName
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Total Attempts</span>
                        <span class="detail-field-value text-sm">
                            @_attempts.Count
                        </span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-field-label">Created</span>
                        <span class="detail-field-value text-sm">
                            @_delivery.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    <Alert Message="@_errorMessage" />

    @if (!_attempts.Any() && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <EmptyState Title="No attempts yet"
                    Description="No delivery attempts have been made for this delivery."
                    Icon="delivery" />
    }
    else
    {
        <!-- Attempt cards -->
        <div class="attempts-list">
            @foreach (var attempt in _attempts.OrderByDescending(a => a.AttemptedAt))
            {
                <div class="card attempts-card">
                    <div class="card-header">
                        <div class="attempts-card-title">
                            <div class="attempts-card-number">
                                #@attempt.AttemptedCount
                            </div>
                            <div class="attempts-card-meta">
                                <span class="attempts-status-code
                                      @(IsSuccessCode(attempt.HttpResponseCode)
                                          ? "attempts-status-success"
                                          : "attempts-status-error")">
                                    @attempt.HttpResponseCode
                                </span>
                                <span class="text-sm text-secondary">
                                    @attempt.Duration ms
                                </span>
                            </div>
                        </div>
                        <div class="attempts-card-time">
                            <span class="text-sm text-secondary">
                                @attempt.AttemptedAt.ToString("MMM dd, yyyy HH:mm:ss")
                            </span>
                            <button class="btn btn-ghost btn-sm"
                                    @onclick="() => ToggleExpand(attempt.Id)"
                                    title="@(_expandedIds.Contains(attempt.Id) ? "Collapse" : "Expand")">
                                <svg viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     style="width:14px;height:14px;
                                            transform:@(_expandedIds.Contains(attempt.Id)
                                                ? "rotate(180deg)" : "rotate(0deg)");
                                            transition:transform 0.2s ease;">
                                    <polyline points="6 9 12 15 18 9" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    @if (_expandedIds.Contains(attempt.Id))
                    {
                        <div class="card-body attempts-response-body">
                            <div class="attempts-response-header">
                                <span class="detail-field-label">HTTP Response</span>
                                <CopyButton Value="@attempt.HttpResponse"
                                            ShowField="false"
                                            Label="Copy response" />
                            </div>
                            @if (string.IsNullOrWhiteSpace(attempt.HttpResponse))
                            {
                                <p class="text-sm text-secondary">No response body.</p>
                            }
                            else
                            {
                                <pre class="attempts-response-pre">@FormatJson(attempt.HttpResponse)</pre>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {

    [Parameter] public Guid DeliveryId { get; set; }

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool          _isLoading    = true;
    private string        _errorMessage = string.Empty;
    private DeliverySummary? _delivery;
    private List<AttemptItem> _attempts = [];
    private HashSet<Guid> _expandedIds = [];

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
        => await LoadAttemptsAsync();

    private async Task LoadAttemptsAsync()
    {
        _isLoading    = true;
        _errorMessage = string.Empty;

        try
        {
            // TODO: replace with real service call once endpoint is available
            // var result = await DeliveryService.GetAttemptsAsync(DeliveryId);
            // if (!result.IsSuccessful)
            // {
            //     _errorMessage = result.ResponseMessage;
            //     return;
            // }
            // _delivery = result.ResponseData.Delivery;
            // _attempts = result.ResponseData.Attempts.ToList();

            await Task.Delay(700);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _errorMessage = "Failed to load delivery attempts. Please try again.";
                return;
            }

            _delivery = new DeliverySummary(
                "OrderCreated",
                "Order Service Sub",
                "Failed",
                DateTimeOffset.UtcNow.AddMinutes(-30));

            _attempts =
            [
                new AttemptItem(
                    Guid.NewGuid(), "500",
                    @"{""error"":""Internal Server Error"",""message"":""Database connection failed.""}",
                    3012.5, DateTimeOffset.UtcNow.AddMinutes(-30), 1),

                new AttemptItem(
                    Guid.NewGuid(), "503",
                    @"{""error"":""Service Unavailable""}",
                    5001.2, DateTimeOffset.UtcNow.AddMinutes(-20), 2),

                new AttemptItem(
                    Guid.NewGuid(), "500",
                    @"{""error"":""Internal Server Error""}",
                    2800.1, DateTimeOffset.UtcNow.AddMinutes(-10), 3),
            ];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------

    private void ToggleExpand(Guid id)
    {
        if (_expandedIds.Contains(id))
            _expandedIds.Remove(id);
        else
            _expandedIds.Add(id);
    }

    private static bool IsSuccessCode(string code)
    {
        if (int.TryParse(code, out int status))
            return status >= 200 && status < 300;
        return false;
    }

    private static string FormatJson(string json)
    {
        try
        {
            var parsed    = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                parsed.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            // Not valid JSON — return as-is
            return json;
        }
    }

    private void NavigateBack()
        => Navigation.NavigateTo("/deliveries");

    // -------------------------------------------------------------------------
    // Local view models
    // -------------------------------------------------------------------------

    private sealed record DeliverySummary(
        string         EventType,
        string         SubscriptionName,
        string         Status,
        DateTimeOffset CreatedAt);

    private sealed record AttemptItem(
        Guid           Id,
        string         HttpResponseCode,
        string         HttpResponse,
        double         Duration,
        DateTimeOffset AttemptedAt,
        int            AttemptedCount);
}
