@page "/admin/users"
@attribute [Authorize(Roles = "Admin,ADMIN")]

<PageTitle>Users — WebhookHub</PageTitle>

<PageSpinner Visible="@_isLoading" Label="Loading users..." />

@if (!_isLoading)
{
    <PageHeader Title="Users"
                Description="Manage registered user accounts."
                BadgeValue="@_users.Count.ToString()"
                BadgeType="custom"
                BadgeCssClass="badge-inactive" />

    <Alert Message="@_errorMessage" />

    @if (!_users.Any() && string.IsNullOrWhiteSpace(_errorMessage))
    {
        <EmptyState Title="No users found"
                    Description="No registered users yet."
                    Icon="user" />
    }
    else
    {
        <div class="card">
            <div class="card-body" style="padding:0;">
                <div class="table-wrapper" style="border:none;border-radius:0;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Username</th>
                                <th>Role</th>
                                <th>Last Login</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _users)
                            {
                                <tr class="table-row-clickable"
                                    @onclick="() => NavigateToSubscriptions(user.Id)">
                                    <td>
                                        <div class="user-name-cell">
                                            <div class="user-avatar">
                                                @user.FirstName[0]@user.LastName[0]
                                            </div>
                                            <span class="text-sm">
                                                @user.FirstName @user.LastName
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-sm text-muted">@user.Email</td>
                                    <td class="table-mono text-sm text-muted">
                                        @user.UserName
                                    </td>
                                    <td>
                                        <Badge Value="@user.Role"
                                               Variant="role"
                                               ShowDot="false" />
                                    </td>
                                    <td class="text-sm text-muted">
                                        @(user.LastLoginDate.HasValue
                                            ? user.LastLoginDate.Value
                                                .ToString("MMM dd, yyyy HH:mm")
                                            : "Never")
                                    </td>
                                    <td>
                                        <Badge Value="@(user.IsActive
                                                       ? "Active" : "Inactive")"
                                               Variant="subscription" />
                                    </td>
                                    <td @onclick:stopPropagation="true">
                                        <div class="table-actions">

                                            <!-- Activate / Deactivate -->
                                            @if (user.IsActive)
                                            {
                                                <button class="btn btn-ghost btn-sm"
                                                        @onclick="() => OpenDeactivateModal(user)"
                                                        title="Deactivate user">
                                                    <svg viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round"
                                                         style="width:15px;height:15px;
                                                                color:var(--color-warning);">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <line x1="8" y1="12" x2="16" y2="12" />
                                                    </svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-ghost btn-sm"
                                                        @onclick="() => OpenReactivateModal(user)"
                                                        title="Reactivate user">
                                                    <svg viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round"
                                                         style="width:15px;height:15px;
                                                                color:var(--color-success);">
                                                        <circle cx="12" cy="12" r="10" />
                                                        <line x1="12" y1="8" x2="12" y2="16" />
                                                        <line x1="8"  y1="12" x2="16" y2="12" />
                                                    </svg>
                                                </button>
                                            }

                                            <!-- Role change -->
                                            <button class="btn btn-ghost btn-sm"
                                                    @onclick="() => OpenRoleModal(user)"
                                                    title="@(user.Role == "Admin"
                                                             ? "Demote to User"
                                                             : "Promote to Admin")"
                                                    disabled="@(user.Email == _currentUserEmail)">
                                                <svg viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round"
                                                     style="width:15px;height:15px;
                                                            color:var(--color-info);">
                                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5
                                                             a4 4 0 0 0-4 4v2" />
                                                    <circle cx="9" cy="7" r="4" />
                                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                                </svg>
                                            </button>

                                            <!-- Revoke tokens -->
                                            <button class="btn btn-ghost btn-sm"
                                                    @onclick="() => OpenRevokeModal(user)"
                                                    title="Revoke all tokens">
                                                <svg viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round"
                                                     style="width:15px;height:15px;
                                                            color:var(--color-danger);">
                                                    <rect x="3" y="11" width="18"
                                                          height="11" rx="2" ry="2" />
                                                    <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                                                    <line x1="12" y1="15" x2="12" y2="17" />
                                                </svg>
                                            </button>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- Deactivate modal -->
@if (_selectedUser is not null)
{
    <Modal @bind-IsOpen="_showDeactivateModal"
           Title="Deactivate User"
           ConfirmText="Deactivate"
           ConfirmVariant="danger"
           IsConfirming="@_isDeactivating"
           OnConfirm="HandleDeactivate"
           OnClose="CloseModals">

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Name</span>
                <span class="subscription-modal-value">
                    @_selectedUser.FirstName @_selectedUser.LastName
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Email</span>
                <span class="subscription-modal-value text-sm">
                    @_selectedUser.Email
                </span>
            </div>
        </div>

        <div class="form-group" style="margin-bottom:var(--space-4);">
            <label class="form-label form-label-required">Justification</label>
            <textarea class="form-input"
                      rows="3"
                      placeholder="Provide a reason for deactivating this account..."
                      @bind="_deactivationJustification"
                      style="resize:vertical;min-height:80px;"
                      disabled="@_isDeactivating">
            </textarea>
            @if (_justificationError)
            {
                <span class="form-error">Justification is required.</span>
            }
        </div>

        <Alert Type="warning"
               Message="Deactivating this account will prevent the user from logging in and stop all their subscriptions from receiving events." />

        <Alert Message="@_deactivateErrorMessage" />

    </Modal>
}

<!-- Reactivate modal -->
@if (_selectedUser is not null)
{
    <Modal @bind-IsOpen="_showReactivateModal"
           Title="Reactivate User"
           ConfirmText="Reactivate"
           ConfirmVariant="primary"
           IsConfirming="@_isReactivating"
           OnConfirm="HandleReactivate"
           OnClose="CloseModals">

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Name</span>
                <span class="subscription-modal-value">
                    @_selectedUser.FirstName @_selectedUser.LastName
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Email</span>
                <span class="subscription-modal-value text-sm">
                    @_selectedUser.Email
                </span>
            </div>
            @if (!string.IsNullOrWhiteSpace(_selectedUser.DeactivationJustification))
            {
                <div class="subscription-modal-row">
                    <span class="subscription-modal-label">Deactivated for</span>
                    <span class="subscription-modal-value text-sm">
                        @_selectedUser.DeactivationJustification
                    </span>
                </div>
            }
        </div>

        <Alert Type="info"
               Message="Reactivating this account will allow the user to log in and resume receiving webhook events." />

        <Alert Message="@_reactivateErrorMessage" />

    </Modal>
}

<!-- Role change modal -->
@if (_selectedUser is not null)
{
    <Modal @bind-IsOpen="_showRoleModal"
           Title="@(_selectedUser.Role == "Admin"
                   ? "Demote to User"
                   : "Promote to Admin")"
           ConfirmText="@(_selectedUser.Role == "Admin"
                         ? "Demote"
                         : "Promote")"
           ConfirmVariant="@(_selectedUser.Role == "Admin" ? "danger" : "primary")"
           IsConfirming="@_isChangingRole"
           OnConfirm="HandleRoleChange"
           OnClose="CloseModals">

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Name</span>
                <span class="subscription-modal-value">
                    @_selectedUser.FirstName @_selectedUser.LastName
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Email</span>
                <span class="subscription-modal-value text-sm">
                    @_selectedUser.Email
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Current Role</span>
                <Badge Value="@_selectedUser.Role"
                       Variant="role"
                       ShowDot="false" />
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">New Role</span>
                <Badge Value="@(_selectedUser.Role == "Admin" ? "User" : "Admin")"
                       Variant="role"
                       ShowDot="false" />
            </div>
        </div>

        <Alert Type="warning"
               Message="@(_selectedUser.Role == "Admin"
                   ? "Demoting this user will remove their admin access immediately."
                   : "Promoting this user will grant them full admin access to all system settings.")" />

        <Alert Message="@_roleErrorMessage" />

    </Modal>
}

<!-- Revoke tokens modal -->
@if (_selectedUser is not null)
{
    <Modal @bind-IsOpen="_showRevokeModal"
           Title="Revoke All Tokens"
           ConfirmText="Revoke Tokens"
           ConfirmVariant="danger"
           IsConfirming="@_isRevoking"
           OnConfirm="HandleRevokeTokens"
           OnClose="CloseModals">

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Name</span>
                <span class="subscription-modal-value">
                    @_selectedUser.FirstName @_selectedUser.LastName
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Email</span>
                <span class="subscription-modal-value text-sm">
                    @_selectedUser.Email
                </span>
            </div>
        </div>

        <Alert Type="error"
               Message="This will immediately invalidate all active sessions for this user. They will be logged out of all devices and must sign in again." />

        <Alert Message="@_revokeErrorMessage" />

    </Modal>
}

@code {

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool   _isLoading        = true;
    private string _errorMessage     = string.Empty;
    private string _currentUserEmail = string.Empty;

    private List<UserDto> _users = [];

    // Deactivate modal
    private bool     _showDeactivateModal       = false;
    private bool     _isDeactivating            = false;
    private bool     _justificationError        = false;
    private string   _deactivationJustification = string.Empty;
    private string   _deactivateErrorMessage    = string.Empty;
    private UserDto? _selectedUser;

    // Reactivate modal
    private bool   _showReactivateModal    = false;
    private bool   _isReactivating         = false;
    private string _reactivateErrorMessage = string.Empty;

    // Role modal
    private bool   _showRoleModal    = false;
    private bool   _isChangingRole   = false;
    private string _roleErrorMessage = string.Empty;

    // Revoke modal
    private bool   _showRevokeModal    = false;
    private bool   _isRevoking         = false;
    private string _revokeErrorMessage = string.Empty;

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        // Get current user email to guard self-demotion
        var authState    = await authenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserEmail = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
            ?? string.Empty;

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoading    = true;
        _errorMessage = string.Empty;

        try
        {
            // TODO: replace with real service call
            // var result = await UserService.GetAllAsync();
            // if (!result.IsSuccessful)
            // {
            //     _errorMessage = result.ResponseMessage;
            //     return;
            // }
            // _users = result.ResponseData?.ToList() ?? [];

            await Task.Delay(700);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _errorMessage = "Failed to load users. Please try again.";
                return;
            }

            _users =
            [
                new UserDto
                {
                    Id            = Guid.NewGuid(),
                    FirstName     = "Abdrahman",
                    LastName      = "Ibrahim",
                    Email         = "abdrahman@parallex.com",
                    UserName      = "abdrahman",
                    Role          = "Admin",
                    IsActive      = true,
                    CreatedAt     = DateTimeOffset.UtcNow.AddDays(-60),
                    LastLoginDate = DateTimeOffset.UtcNow.AddHours(-2)
                },
                new UserDto
                {
                    Id            = Guid.NewGuid(),
                    FirstName     = "John",
                    LastName      = "Doe",
                    Email         = "john.doe@example.com",
                    UserName      = "johndoe",
                    Role          = "User",
                    IsActive      = false,
                    CreatedAt     = DateTimeOffset.UtcNow.AddDays(-30),
                    LastLoginDate = DateTimeOffset.UtcNow.AddDays(-10),
                    DeactivationJustification = "Suspicious activity detected."
                }
            ];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // -------------------------------------------------------------------------
    // Navigation
    // -------------------------------------------------------------------------

    private void NavigateToSubscriptions(Guid userId)
        => navigationManager.NavigateTo($"/subscriptions?userId={userId}");

    // -------------------------------------------------------------------------
    // Modal openers
    // -------------------------------------------------------------------------

    private void OpenDeactivateModal(UserDto user)
    {
        _selectedUser              = user;
        _deactivationJustification = string.Empty;
        _justificationError        = false;
        _deactivateErrorMessage    = string.Empty;
        _showDeactivateModal       = true;
    }

    private void OpenReactivateModal(UserDto user)
    {
        _selectedUser           = user;
        _reactivateErrorMessage = string.Empty;
        _showReactivateModal    = true;
    }

    private void OpenRoleModal(UserDto user)
    {
        _selectedUser    = user;
        _roleErrorMessage = string.Empty;
        _showRoleModal   = true;
    }

    private void OpenRevokeModal(UserDto user)
    {
        _selectedUser      = user;
        _revokeErrorMessage = string.Empty;
        _showRevokeModal   = true;
    }

    private void CloseModals()
    {
        _showDeactivateModal = false;
        _showReactivateModal = false;
        _showRoleModal       = false;
        _showRevokeModal     = false;
        _selectedUser        = null;

        _deactivationJustification = string.Empty;
        _justificationError        = false;
        _deactivateErrorMessage    = string.Empty;
        _reactivateErrorMessage    = string.Empty;
        _roleErrorMessage          = string.Empty;
        _revokeErrorMessage        = string.Empty;
    }

    // -------------------------------------------------------------------------
    // Handlers
    // -------------------------------------------------------------------------

    private async Task HandleDeactivate()
    {
        if (_selectedUser is null) return;

        if (string.IsNullOrWhiteSpace(_deactivationJustification))
        {
            _justificationError = true;
            return;
        }

        _justificationError     = false;
        _deactivateErrorMessage = string.Empty;
        _isDeactivating         = true;

        try
        {
            // TODO: replace with real service call
            // var result = await UserService.DeactivateAsync(
            //     _selectedUser.Id, _deactivationJustification);
            //
            // if (!result.IsSuccessful)
            // {
            //     _deactivateErrorMessage = result.ResponseMessage;
            //     return;
            // }

            await Task.Delay(800);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _deactivateErrorMessage = "Failed to deactivate user. Please try again.";
                return;
            }

            var index = _users.IndexOf(_selectedUser);
            if (index >= 0)
            {
                _users[index] = _selectedUser with
                {
                    IsActive                  = false,
                    DeactivationJustification = _deactivationJustification
                };
            }

            toastService.ShowSuccess(
                $"{_selectedUser.FirstName} {_selectedUser.LastName} deactivated.");
            CloseModals();
        }
        finally
        {
            _isDeactivating = false;
        }
    }

    private async Task HandleReactivate()
    {
        if (_selectedUser is null) return;

        _reactivateErrorMessage = string.Empty;
        _isReactivating         = true;

        try
        {
            // TODO: replace with real service call
            // var result = await UserService.ReactivateAsync(_selectedUser.Id);
            // if (!result.IsSuccessful)
            // {
            //     _reactivateErrorMessage = result.ResponseMessage;
            //     return;
            // }

            await Task.Delay(800);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _reactivateErrorMessage = "Failed to reactivate user. Please try again.";
                return;
            }

            var index = _users.IndexOf(_selectedUser);
            if (index >= 0)
            {
                _users[index] = _selectedUser with
                {
                    IsActive                  = true,
                    DeactivationJustification = null
                };
            }

            toastService.ShowSuccess(
                $"{_selectedUser.FirstName} {_selectedUser.LastName} reactivated.");
            CloseModals();
        }
        finally
        {
            _isReactivating = false;
        }
    }

    private async Task HandleRoleChange()
    {
        if (_selectedUser is null) return;

        _roleErrorMessage = string.Empty;
        _isChangingRole   = true;

        try
        {
            var newRole = _selectedUser.Role == "Admin" ? "User" : "Admin";

            // TODO: replace with real service call
            // var result = await UserService.ChangeRoleAsync(new ChangeRoleDto
            // {
            //     UserEmailAddress = _selectedUser.Email,
            //     NewRoleToAssign  = newRole
            // });
            //
            // if (!result.IsSuccessful)
            // {
            //     _roleErrorMessage = result.ResponseMessage;
            //     return;
            // }

            await Task.Delay(800);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _roleErrorMessage = "Failed to change role. Please try again.";
                return;
            }

            var index = _users.IndexOf(_selectedUser);
            if (index >= 0)
                _users[index] = _selectedUser with { Role = newRole };

            toastService.ShowSuccess(
                $"{_selectedUser.FirstName} {_selectedUser.LastName} " +
                $"{(newRole == "Admin" ? "promoted to Admin" : "demoted to User")}.");
            CloseModals();
        }
        finally
        {
            _isChangingRole = false;
        }
    }

    private async Task HandleRevokeTokens()
    {
        if (_selectedUser is null) return;

        _revokeErrorMessage = string.Empty;
        _isRevoking         = true;

        try
        {
            // TODO: replace with real service call
            // var result = await UserService.RevokeTokensAsync(_selectedUser.Id);
            // if (!result.IsSuccessful)
            // {
            //     _revokeErrorMessage = result.ResponseMessage;
            //     return;
            // }

            await Task.Delay(800);

            bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if (!success)
            {
                _revokeErrorMessage = "Failed to revoke tokens. Please try again.";
                return;
            }

            toastService.ShowSuccess(
                $"All tokens revoked for {_selectedUser.FirstName} " +
                $"{_selectedUser.LastName}. They have been logged out of all devices.");
            CloseModals();
        }
        finally
        {
            _isRevoking = false;
        }
    }

    // -------------------------------------------------------------------------
    // Local view model
    // -------------------------------------------------------------------------

    private sealed record UserDto
    {
        public Guid            Id                        { get; init; }
        public string          FirstName                 { get; init; } = string.Empty;
        public string          LastName                  { get; init; } = string.Empty;
        public string          Email                     { get; init; } = string.Empty;
        public string          UserName                  { get; init; } = string.Empty;
        public string          Role                      { get; init; } = "User";
        public bool            IsActive                  { get; init; }
        public DateTimeOffset  CreatedAt                 { get; init; }
        public DateTimeOffset? LastLoginDate             { get; init; }
        public string?         DeactivationJustification { get; init; }
    }
}
