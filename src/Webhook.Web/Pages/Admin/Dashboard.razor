    private string FormatLastRaised(DateTimeOffset? lastRaised)
    {
        if (lastRaised is null) return "never";

        var diff = DateTime.UtcNow - lastRaised.Value;

        return diff switch
        {
            {
     TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{(int)diff.TotalMinutes}m ago",
            { TotalDays: < 1 } => $"{(int)diff.TotalHours}h ago",
            { TotalDays: < 7 } => $"{(int)diff.TotalDays}d ago",
            _ => lastRaised.Value.ToString("dd MMM yyyy")
        };
    }
