@page "/admin/dashboard"
@attribute [Authorize(Roles = "Admin,ADMIN")]

<PageTitle>Admin Dashboard — WebhookHub</PageTitle>

<PageSpinner Visible="@_isLoading" Label="Loading system overview..." />

@if (!_isLoading)
{

    <DashboardHeader Title="System Overview"
                     Description="Real-time view of the WebhookHub delivery pipeline."
                     IsRefreshing="_isRefreshing"
                     OnRefresh="RefreshDashboard"
                     OnFilterApplied="HandleFilterApplied"
                     OnFilterCleared="HandleFilterCleared">
        <AdditionalActions>
            <a href="/admin/health" class="btn btn-secondary btn-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="width:14px;height:14px;">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>
                Health Checks
            </a>
            @* <button class="btn btn-secondary btn-sm" @onclick="RefreshDashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="width:14px;height:14px;">
                    <polyline points="23 4 23 10 17 10" />
                    <polyline points="1 20 1 14 7 14" />
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10
                    M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                </svg>
                Refresh
            </button> *@
        </AdditionalActions>
    </DashboardHeader>
    <!-- Greeting -->
    @* <div class="dashboard-greeting">
        <div>
            <h1 class="page-title">System Overview</h1>
            <p class="page-header-description">
                Real-time view of the WebhookHub delivery pipeline.
            </p>
        </div>
        <div class="dashboard-greeting-actions">
            <a href="/admin/health" class="btn btn-secondary btn-sm">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="width:14px;height:14px;">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>
                Health Checks
            </a>
            <button class="btn btn-secondary btn-sm" @onclick="RefreshDashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="width:14px;height:14px;">
                    <polyline points="23 4 23 10 17 10" />
                    <polyline points="1 20 1 14 7 14" />
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10
                             M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                </svg>
                Refresh
            </button>
        </div>
    </div> *@

    <!-- Row 1 — System entity counts -->
    @if (_summaryActivity is not null)
    {
        <!-- Row 1 — Platform overview metrics -->
        <div class="dashboard-metrics-grid" style="margin-bottom:var(--space-4);">
            <div class="metric-card">
                <span class="metric-card-label">Total Users</span>
                <span class="metric-card-value">@_totalUsers</span>
                <span class="metric-card-sub">Registered accounts</span>
            </div>
            <div class="metric-card">
                <span class="metric-card-label">Total Subscriptions</span>
                <span class="metric-card-value">@_totalSubscriptions</span>
                <span class="metric-card-sub">Across all users</span>
            </div>
            <div class="metric-card">
                <span class="metric-card-label">Service Clients</span>
                <span class="metric-card-value">@_totalServiceClients</span>
                <span class="metric-card-sub">Onboarded internal services</span>
            </div>
            <div class="metric-card">
                <span class="metric-card-label">Event Types</span>
                <span class="metric-card-value">@_totalEventTypes</span>
                <span class="metric-card-sub">Active catalog entries</span>
            </div>
        </div>

        <!-- Row 2 — Pipeline health metrics -->
        <div class="dashboard-metrics-grid dashboard-metrics-grid-secondary"
             style="margin-bottom:var(--space-6);">
            <div class="metric-card">
                <span class="metric-card-label">Events Today</span>
                <span class="metric-card-value">@_eventsToday</span>
                <span class="metric-card-sub">Published across all clients</span>
            </div>
            <div class="metric-card">
                <span class="metric-card-label">Global Success Rate</span>
                <span class="metric-card-value" style="color:@SuccessRateColor;">
                    @_successRate%
                </span>
                <span class="metric-card-sub">Delivery success today</span>
            </div>
            <div class="metric-card">
                <span class="metric-card-label">Pending</span>
                <span class="metric-card-value" style="color:var(--color-warning);">
                    @_pendingDeliveries
                </span>
                <span class="metric-card-sub">Queued for delivery</span>
            </div>
            <div class="metric-card">
                <span class="metric-card-label">Dead Letters</span>
                <span class="metric-card-value" style="color:var(--color-dead-letter);">
                    @_deadLetterCount
                </span>
                <span class="metric-card-sub">Awaiting admin retry</span>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-metrics-grid" style="margin-bottom:var(--space-4);">
            @for (int i = 0; i < 4; i++)
            {
                <div class="metric-card metric-card--skeleton">
                    <span class="skeleton skeleton-label"></span>
                    <span class="skeleton skeleton-value"></span>
                    <span class="skeleton skeleton-sub"></span>
                </div>
            }
        </div>
        <div class="dashboard-metrics-grid dashboard-metrics-grid-secondary"
             style="margin-bottom:var(--space-6);">
            @for (int i = 0; i < 4; i++)
            {
                <div class="metric-card metric-card--skeleton">
                    <span class="skeleton skeleton-label"></span>
                    <span class="skeleton skeleton-value"></span>
                    <span class="skeleton skeleton-sub"></span>
                </div>
            }
        </div>
    }

    <!-- Worker status + Health checks side by side -->
    <div class="admin-dashboard-split" style="margin-bottom:var(--space-6);">

        <!-- Worker status -->
        <div class="card" style="height:100%;display:flex;flex-direction:column;">
            <div class="card-header">
                <h2 class="card-title">Worker Status</h2>
                <a href="/admin/health" class="btn btn-ghost btn-sm">
                    View health
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="width:14px;height:14px;">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </a>
            </div>
            <div class="card-body" style="flex:1;overflow-y:auto;">
                @if (_isLoadingWorkers)
                {
                    <div style="display:flex;flex-direction:column;gap:var(--space-3);">
                        @for (int i = 0; i < 6; i++)
                        {
                            <SkeletonLoader Shape="text" Width="180px" Height="20px" />
                        }
                    </div>
                }
                else
                {
                    <div class="admin-worker-list" style="height:100%;justify-content:space-evenly;">
                        @foreach (var worker in _workers)
                        {
                            <div class="admin-worker-item">
                                <StatusDot Status="@worker.Status"
                                           Pulse="@(worker.Status == "Healthy")" />
                                <span class="text-sm">@worker.Name</span>
                                <Badge Value="@worker.Status"
                                       Variant="custom"
                                       Text="@worker.Status"
                                       ShowDot="false" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Health checks summary -->
        <div class="card" style="height:100%;display:flex;flex-direction:column;">
            <div class="card-header">
                <h2 class="card-title">Health Checks</h2>
                <Badge Value="@_overallHealth"
                       Variant="custom"
                       Text="@_overallHealth"
                       ShowDot="false" />
            </div>
            <div class="card-body" style="padding:0;flex:1;overflow-y:auto;">
                @if (_isLoadingHealth)
                {
                    <div style="padding:var(--space-4);display:flex;
                        flex-direction:column;gap:var(--space-3);">
                        @for (int i = 0; i < 5; i++)
                        {
                            <SkeletonLoader Shape="text" Width="100%" Height="20px" />
                        }
                    </div>
                }
                else if (!_healthChecks.Any())
                {
                    <div style="padding:var(--space-6);display:flex;flex-direction:column;
                        align-items:center;gap:var(--space-2);text-align:center;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                             viewBox="0 0 24 24" fill="none" stroke="var(--muted)"
                             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                        </svg>
                        @if (!string.IsNullOrEmpty(_healthCheckErrorMessage))
                        {
                            <span class="text-sm font-semibold" style="color:var(--color-danger);">
                                @_healthCheckErrorMessage
                            </span>
                        }
                        else
                        {
                            <span class="text-sm font-semibold">No health checks registered</span>
                            <span class="text-xs text-muted">Health check services will appear here once configured.</span>
                        }
                        
                    </div>
                }
                else
                {
                    <ul class="admin-health-list" style="height:100%;justify-content:space-evenly;">
                        @foreach (var check in _healthChecks)
                        {
                            <li class="admin-health-item">
                                <StatusDot Status="@check.Status" />
                                <span class="text-sm admin-health-name">@check.Name</span>
                                <span class="text-xs text-muted">
                                    @check.DurationMs.ToString("F") ms
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

    </div>

    <!-- Service client activity + Top failing subscriptions -->
    <div class="admin-dashboard-split" style="margin-bottom:var(--space-6);">

        <!-- Service client activity -->
        <div class="card" style="height:100%;display:flex;flex-direction:column;">
            <div class="card-header">
                <h2 class="card-title">Event Catalog Activity</h2>
                <a href="/admin/event-catalog" class="btn btn-ghost btn-sm">
                    View all Catalogs
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="width:14px;height:14px;">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </a>
            </div>
            <div class="card-body" style="padding:0;flex:1;overflow-y:auto;">
                @if (_isLoadingClients)
                {
                    <TableSkeleton Rows="4" Columns="3" ShowHeader="false" />
                }
                else if (!_catalogActivity.Any())
                {
                    <EmptyState Title="No activity"
                                Description="@(string.IsNullOrEmpty(_loadEventCatalogAnalyticsErrorMessage) ? "No published events for catalogs." : _loadEventCatalogAnalyticsErrorMessage)"
                                Icon="client" />
                }
                else
                {
                    <ul class="admin-client-activity-list" style="height:100%;justify-content:space-evenly;">
                        @foreach (var catalog in _catalogActivity)
                        {
                            <li class="admin-client-activity-item">
                                <div class="admin-client-activity-info">
                                    <span class="text-sm font-semibold">
                                        @catalog.NormalizedEventName
                                    </span>
                                    <span class="text-xs text-secondary">
                                        @catalog.ActiveSubscriptions subscription@(catalog.ActiveSubscriptions == 1 ? "" : "s")
                                    </span>
                                    <span class="text-xs text-secondary">
                                        Last raised @FormatLastRaised(catalog.LastRaised)
                                    </span>
                                </div>
                                <div class="admin-client-activity-count">
                                    <span class="text-sm font-bold">
                                        @catalog.TotalRaisedEvents
                                    </span>

                                    <span class="text-xs text-secondary">@(catalog.TotalRaisedEvents > 1 ? "events" : catalog.TotalRaisedEvents == 1 ? "event" : "")</span>
                                </div>
                            </li>
                        }
                    </ul>
                    @* <ul class="admin-client-activity-list">
                        @foreach (var client in _clientActivity)
                        {
                            <li class="admin-client-activity-item">
                                <div class="admin-client-activity-info">
                                    <span class="text-sm table-mono">
                                        @client.ClientId
                                    </span>
                                    <span class="text-xs text-muted">
                                        @client.ServiceName
                                    </span>
                                </div>
                                <div class="admin-client-activity-count">
                                    <span class="text-sm font-semibold">
                                        @client.EventsToday
                                    </span>
                                    <span class="text-xs text-muted">events</span>
                                </div>
                            </li>
                        }
                    </ul> *@
                }
            </div>
        </div>

        <!-- Top failing subscriptions — system-wide -->
        <div class="card" style="height:100%;display:flex;flex-direction:column;">
            <div class="card-header">
                <h2 class="card-title">Top Failing Subscriptions</h2>
                <a href="/deliveries" class="btn btn-ghost btn-sm">
                    View all
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="width:14px;height:14px;">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </a>
            </div>
            <div class="card-body" style="padding:0;flex:1;overflow-y:auto;">
                @if (_isLoadingFailures)
                {
                    <TableSkeleton Rows="4" Columns="3" ShowHeader="false" />
                }
                else if (!_topFailures.Any())
                {
                    <EmptyState Title="No failing subscriptions"
                                Description="@(string.IsNullOrEmpty(_loadTopFailingSubscriptionErrorMessage) ? "All subscriptions are delivering successfully." : _loadTopFailingSubscriptionErrorMessage)"
                                Icon="delivery" />
                }
                else
                {
                    
                    <ul class="admin-client-activity-list" style="height:100%;justify-content:start;">
                        @foreach (var sub in _topFailures)
                        {
                            <li class="admin-client-activity-item">
                                <div class="admin-client-activity-info">
                                    <span class="text-sm">@sub.Name</span>
                                    <span class="text-xs text-muted truncate"
                                          style="max-width:160px;"
                                          title="@sub.CallbackUrl">
                                        @sub.CallbackUrl
                                    </span>
                                </div>
                                <div class="admin-client-activity-count">
                                    <span class="text-sm font-semibold"
                                          style="color:var(--color-danger);">
                                        @sub.FailedCount
                                    </span>
                                    <span class="text-xs text-muted">failed</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

    </div>

    <!-- Recent system events -->
    <div class="card" style="height:100%;display:flex;flex-direction:column;">
        <div class="card-header">
            <h2 class="card-title">Recent System Events</h2>
            <span class="text-sm text-muted">All sources</span>
        </div>
        <div class="card-body" style="padding:0;flex:1;overflow-y:auto;">
            @if (_isLoadingEvents)
            {
                <TableSkeleton Rows="6" Columns="5" />
            }
            else if (!_recentEvents.Any())
            {
                <EmptyState Title="No recent events"
                            Description="@(string.IsNullOrEmpty(_loadRecentEventErrorMessage) ? "No events have been published today." : _loadRecentEventErrorMessage)"
                            Icon="webhook" />
            }
            else
            {
                <div class="table-wrapper" style="border:none;border-radius:0;height:100%;justify-content:space-evenly;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Event Type</th>
                                <th>Source</th>
                                <th>Correlation ID</th>
                                <th>Deliveries</th>
                                <th>Published</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in _recentEvents)
                            {
                                <tr>
                                    <td class="table-mono text-sm">@evt.EventType</td>
                                    <td class="text-sm table-mono">@evt.Source</td>
                                    <td>
                                        <CopyButton Value="@evt.CorrelationId.ToString()"
                                                    DisplayText="@($"{evt.CorrelationId.ToString()[..8]}...")"
                                                    ShowField="true" />
                                    </td>
                                    <td class="text-sm text-muted">
                                        @evt.DeliveryCount
                                    </td>
                                    <td class="text-sm text-muted">
                                        @evt.PublishedAt.ToString("HH:mm:ss")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool _isLoading        = true;
    private bool _isLoadingWorkers = true;
    private bool _isLoadingHealth  = true;
    private bool _isLoadingClients = true;
    private bool _isLoadingFailures = true;
    private bool _isLoadingEvents  = true;

    // Entity counts
    private int _totalUsers         = 0;
    private int _totalSubscriptions = 0;
    private int _totalServiceClients = 0;
    private int _totalEventTypes    = 0;

    // Pipeline metrics
    private int    _eventsToday      = 0;
    private double _successRate      = 0;
    private int    _pendingDeliveries = 0;
    private int    _deadLetterCount  = 0;

    // Section data
    private string                   _overallHealth  = "Unknown";
    private List<WorkerItem>         _workers        = [];
    private List<HealthCheckItem>    _healthChecks   = [];
    private List<ClientActivityItem> _clientActivity = [];
    private List<FailingSubItem>     _topFailures    = [];
    private List<SystemEventItem>    _recentEvents   = [];
    private List<EventCatalogReportingAnalyticsEntity> _catalogActivity = [];
    private AdminDashboardSummaryReportingAnalyticsEntity? _summaryActivity;

    private bool _isRefreshing;
    private string _loadRecentEventErrorMessage = string.Empty;
    private string _loadEventCatalogAnalyticsErrorMessage = string.Empty;
    private string _loadTopFailingSubscriptionErrorMessage = string.Empty;
    private string _loadSummaryAnalyticsErrorMessage = string.Empty;
    private string _healthCheckErrorMessage = string.Empty;

    // -------------------------------------------------------------------------
    // Computed
    // -------------------------------------------------------------------------

    private string SuccessRateColor => _successRate switch
    {
        >= 95 => "var(--color-success)",
        >= 80 => "var(--color-warning)",
        _     => "var(--color-danger)"
    };

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
        => await LoadDashboardAsync();

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;

        try
        {
            // TODO: replace with real parallel service calls
            // var metricsTask = AdminService.GetSystemMetricsAsync();
            // await Task.WhenAll(metricsTask);
            // var metrics = metricsTask.Result.ResponseData;

            await Task.Delay(800);

            var result = await getAdminDashboardSummaryHandler.HandleAsync();
            if (!result.response.successStatus)
            {
                _loadSummaryAnalyticsErrorMessage = result.response.responseMessage;
                _isLoading = false;
                StateHasChanged();
                return;
            }

            // bool success = DateTimeOffset.UtcNow.Second % 2 == 0;

            if(result.adminDahsboardSummary is null)
            {
                _loadSummaryAnalyticsErrorMessage = result.response.responseMessage;
                _isLoading = false;
                StateHasChanged();
                return;
            }

            _summaryActivity = result.adminDahsboardSummary;

            _totalUsers = result.adminDahsboardSummary.TotalOnboardedUsers;
            _totalSubscriptions = result.adminDahsboardSummary.SubscriptionCount;
            _totalServiceClients = result.adminDahsboardSummary.TotalServiceClients;
            _totalEventTypes = result.adminDahsboardSummary.ActiveCatalogs;
            _eventsToday = result.adminDahsboardSummary.TotalRaisedEvent;
            _successRate = result.adminDahsboardSummary.SuccessRate;
            _pendingDeliveries = result.adminDahsboardSummary.TotalPendingDeliveries;
            _deadLetterCount = result.adminDahsboardSummary.TotalPendingDeadLetter;


            // _totalUsers          = success ? 48  : 0;
            // _totalSubscriptions  = success ? 124 : 0;
            // _totalServiceClients = success ? 6   : 0;
            // _totalEventTypes     = success ? 12  : 0;
            // _eventsToday         = success ? 842 : 0;
            // _successRate         = success ? 97.3 : 0;
            // _pendingDeliveries   = success ? 7   : 0;
            // _deadLetterCount     = success ? 11  : 0;

            _isLoading = false;
            StateHasChanged();

            // Load sections progressively
            // await LoadWorkersAndHealthAsync();
            // await LoadClientActivityAsync();
            // await LoadTopFailuresAsync();
            // await LoadRecentEventsAsync();
            await Task.WhenAll( LoadWorkersAndHealthAsync(),
                LoadClientActivityAsync());
               // await Task.Delay(500);
            await Task.WhenAll(
                LoadTopFailuresAsync(),
                LoadRecentEventsAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadWorkersAndHealthAsync()
    {
        _isLoadingWorkers = true;
        _isLoadingHealth  = true;

        await Task.Delay(400);

        // TODO: replace with real health check call
        // var result = await HealthService.GetHealthAsync();

        var result = await healthCheckStatusHandler.HandleAsync();

        if(result is null)
        {
            _healthCheckErrorMessage = "Failed to retrieve health check status.";
            _isLoadingWorkers = false;
            _isLoadingHealth = false;
            StateHasChanged();
            return;
        }

        _overallHealth = result.status;
        _healthChecks = result.checks.Select(x => new HealthCheckItem(Name: x.name.ToLower(), Status: x.status, DurationMs: x.duration)).ToList();

        _workers =
        [
            new("EventRaisedWorker",                "Healthy"),
            new("PendingRaisedEventWorker",          "Healthy"),
            new("DeliveryWorker",                    "Healthy"),
            new("RetryWorker",                       "Healthy"),
            new("StaleClaimedDeliveryReleaseWorker", "Healthy"),
            new("EmailProcessorWorker",              "Healthy"),
        ];

        // _healthChecks =
        // [
        //     new("postgresql",         "Healthy",   12.3),
        //     new("email-queue",        "Healthy",   0.1),
        //     new("dead-letter-queue",  "Degraded",  1.8),
        //     new("pending-deliveries", "Healthy",   2.1),
        //     new("stale-processing",   "Healthy",   0.9),
        // ];

        // _overallHealth = _healthChecks.Any(h => h.Status == "Unhealthy")
        //     ? "Unhealthy"
        //     : _healthChecks.Any(h => h.Status == "Degraded")
        //         ? "Degraded"
        //         : "Healthy";

        _isLoadingWorkers = false;
        _isLoadingHealth  = false;
        StateHasChanged();
    }

    private async Task LoadClientActivityAsync()
    {
        _isLoadingClients = true;

        await Task.Delay(500);

        var result = await getEventCatalogAnalyticsHandler.HandleAsync();

        if (!result.response.successStatus)
        {
            _loadEventCatalogAnalyticsErrorMessage = result.response.responseMessage;
            _isLoadingClients = false;
            _catalogActivity = [];
            StateHasChanged();
            return;
        }

        _catalogActivity = result.catalogEntities.ToList();

        // _clientActivity =
        // [
        //     new("order-service-prod",   "Order Management Service", 312),
        //     new("payment-gateway-prod", "Payment Gateway",          198),
        //     new("notification-prod",    "Notification Service",     87),
        // ];

        _isLoadingClients = false;
        StateHasChanged();
    }

    private async Task LoadTopFailuresAsync()
    {
        _isLoadingFailures = true;

        await Task.Delay(600);

        var result = await getTopFailingSubscriptionsHandler.HandleAsync();

        if (!result.response.successStatus)
        {
            _loadEventCatalogAnalyticsErrorMessage = result.response.responseMessage;
            _isLoadingFailures = false;
            _topFailures = [];
            StateHasChanged();
            return;
        }

        _topFailures = result.subscriptions.Select(x => new FailingSubItem(Name: x.SubscriptionName, CallbackUrl: x.CallBackUrl, FailedCount: x.FailedCount)).ToList();

        // _topFailures =
        // [
        //     new("Order Service Sub",   "https:orders.internal/webhook", 24),
        //     new("CRM Sub",             "https:crm.internal/hooks",      16),
        //     new("Notification Sub",    "https:notify.internal/events",  8),
        // ];

        _isLoadingFailures = false;
        StateHasChanged();
    }

    private async Task LoadRecentEventsAsync()
    {
        _isLoadingEvents = true;

        await Task.Delay(400);

        var result = await getMostRecentEventsHandler.HandleAsync();

        if (!result.Item1.successStatus)
        {
            _loadRecentEventErrorMessage = result.Item1.responseMessage;
            _isLoadingEvents = false;
            return;
        }

        _recentEvents = result.Item2.Select(x => new SystemEventItem(EventType: x.EventType, Source: x.Source, CorrelationId: x.CorrelationId, DeliveryCount: x.DeliveryCount, PublishedAt: x.CreatedAt) ).ToList();

        // _recentEvents =
