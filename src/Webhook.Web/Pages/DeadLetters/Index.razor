@page "/dead-letters/{DeliveryId:guid}"
@using WebHook.Core.DataTransferObjects.WebhookDeadLetterQueue
@attribute [Authorize]

@inject Webhook.Web.Handlers.Delivery.GetDeliveryDeadLettersHandler getDeliveryDeadLettersHandler
@inject Webhook.Web.Handlers.Delivery.RequestDeadLetterDeliveryRetryHandler requestDeadLetterDeliveryRetryHandler

<PageTitle>Dead Letters — WebhookHub</PageTitle>

<PageSpinner Visible="@_isLoading" Label="Loading dead letters..." />

@if (!_isLoading)
{
    <PageHeader Title="Dead Letters"
                Description="Deliveries that have exhausted all retry attempts." />

    <!-- Filters -->
    @* <div class="card" style="margin-bottom:var(--space-5);">
        <div class="card-body">
            <div class="dead-letters-filters">

                <div class="form-group">
                    <label class="form-label" for="dateFrom">From</label>
                    <input id="dateFrom"
                           type="date"
                           class="form-input"
                           @bind="_filterDateFrom"
                           @bind:after="ApplyFilters" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="dateTo">To</label>
                    <input id="dateTo"
                           type="date"
                           class="form-input"
                           @bind="_filterDateTo"
                           @bind:after="ApplyFilters" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="retriedFilter">Status</label>
                    <select id="retriedFilter"
                            class="form-select"
                            @bind="_filterRetried"
                            @bind:after="ApplyFilters">
                        <option value="">All</option>
                        <option value="false">Not retried</option>
                        <option value="true">Retried</option>
                    </select>
                </div>

                <div class="form-group" style="justify-content:flex-end;">
                    <label class="form-label" style="visibility:hidden;">clear</label>
                    <button class="btn btn-ghost btn-sm" @onclick="ClearFilters">
                        Clear filters
                    </button>
                </div>

            </div>
        </div>
    </div> *@

    <Alert Message="@_errorMessage" />

    @if (_isFiltering)
    {
        <TableSkeleton Rows="6" Columns="5" />
    }
    else if (!_deadLetters.Any())
    {
        <EmptyState Title="No dead letters found"
                    Description="@(HasActiveFilters
                        ? "No dead letters match your current filters."
                        : "All deliveries are healthy — no dead letters to show.")"
                    Icon="deadletter" />
    }
    else
    {
        <div class="card">
            <div class="card-body" style="padding:0;">
                <div class="table-wrapper" style="border:none;border-radius:0;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Reason</th>
                                <th>Retried</th>
                                <th>Retried By</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dl in _deadLetters)
                            {
                                <tr class="table-row-clickable"
                                    @onclick="() => OpenDetailModal(dl)">
                                    <td class="text-sm text-muted"
                                        style="max-width:225px;">
                                        <span class="truncate" title="@dl.reason" style="white-space:wrap;">
                                            @(string.IsNullOrWhiteSpace(dl.reason) ? "—" : dl.reason)
                                        </span>
                                    </td>
                                    <td>
                                        @if (dl.RetriedAt.HasValue)
                                        {
                                            <div style="display:flex;flex-direction:column;gap:6px;">
                                                <Badge Value="Retried"
                                                       Variant="custom"
                                                       Text="Retried" />
                                                <span class="text-xs text-secondary">
                                                    @dl.RetriedAt.Value.ToString("MMM dd, HH:mm")
                                                </span>
                                            </div>
                                        }
                                        else
                                        {
                                            <Badge Value="Pending"
                                                   Variant="custom"
                                                   Text="Not retried" />
                                        }
                                    </td>
                                    <td class="text-sm text-muted">
                                        @(string.IsNullOrWhiteSpace(dl.retriedBy) ? "—" : dl.retriedBy)
                                    </td>
                                    <td class="text-sm text-muted">
                                        @dl.createdAt.ToString("MMM dd, yyyy HH:mm")
                                    </td>
                                    <td @onclick:stopPropagation="true">
                                        <button class="btn btn-outline btn-sm"
                                                @onclick="() => OpenRetryModal(dl)"
                                                title="Manual retry" disabled="@(dl.RetriedAt.HasValue)">
                                            <svg viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round"
                                                 style="width:13px;height:13px;">
                                                <polyline points="23 4 23 10 17 10" />
                                                <path d="M20.49 15a9 9 0 1 1
                                                         -2.12-9.36L23 10" />
                                            </svg>
                                            Retry
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- Detail modal — row click -->
@if (_selectedDeadLetter is not null)
{
    <Modal @bind-IsOpen="_showDetailModal"
           Title="Dead Letter Details"
           ShowFooter="false"
           OnClose="CloseModals"
           Size="sm">

        

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Created</span>
                <span class="subscription-modal-value text-sm">
                    @_selectedDeadLetter.createdAt.ToString("MMM dd, yyyy HH:mm:ss")
                </span>
            </div>

            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Reason</span>
                <span class="subscription-modal-value text-sm">
                    @(string.IsNullOrWhiteSpace(_selectedDeadLetter.reason) ? "—"  : _selectedDeadLetter.reason)
                </span>
            </div>
            
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Retried</span>
                @if (_selectedDeadLetter.RetriedAt.HasValue)
                {
                    <span class="subscription-modal-value text-sm">
                        @_selectedDeadLetter.RetriedAt.Value.ToString("MMM dd, yyyy HH:mm:ss")
                    </span>
                }
                else
                {
                    <span class="subscription-modal-value text-sm text-muted">
                        Not retried
                    </span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_selectedDeadLetter.retriedBy))
            {
                <div class="subscription-modal-row">
                    <span class="subscription-modal-label">Retried By</span>
                    <span class="subscription-modal-value text-sm">
                        @_selectedDeadLetter.retriedBy
                    </span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_selectedDeadLetter.RetryJustification))
            {
                <div class="subscription-modal-row">
                    <span class="subscription-modal-label">Justification</span>
                    <span class="subscription-modal-value text-sm">
                        @_selectedDeadLetter.RetryJustification
                    </span>
                </div>
            }
        </div>

        <div style="display:flex;justify-content:flex-end;
                    gap:var(--space-3);margin-top:var(--space-4);">
            <button class="btn btn-ghost btn-sm"
                    @onclick="CloseModals">
                Close
            </button>
            @if (!_selectedDeadLetter.RetriedAt.HasValue)
            {
                <button class="btn btn-outline btn-sm"
                        @onclick="() => OpenRetryModalFromDetails(_selectedDeadLetter)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="width:13px;height:13px;">
                        <polyline points="23 4 23 10 17 10" />
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                    </svg>
                    Retry
                </button>
            }
            
        </div>

    </Modal>
}

<!-- Retry modal -->
@if (_selectedDeadLetter is not null)
{
    <Modal @bind-IsOpen="_showRetryModal"
           Title="Manual Retry"
           ConfirmText="Retry Delivery"
           ConfirmVariant="primary"
           IsConfirming="@_isRetrying"
           OnConfirm="HandleRetry"
           OnClose="CloseModals">

        <div class="subscription-modal-details">
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Reason</span>
                <span class="subscription-modal-value text-sm">
                    @(string.IsNullOrWhiteSpace(_selectedDeadLetter.reason) ? "—" : _selectedDeadLetter.reason)
                </span>
            </div>
            <div class="subscription-modal-row">
                <span class="subscription-modal-label">Created</span>
                <span class="subscription-modal-value text-sm">
                    @_selectedDeadLetter.createdAt.ToString("MMM dd, yyyy HH:mm")
                </span>
            </div>
        </div>

        <!-- Retry justification -->
        <div class="form-group" style="margin-bottom:var(--space-4);">
            <label class="form-label form-label-required">
                Justification
            </label>
            <textarea class="form-input"
                      rows="3" maxlength="500"
                      placeholder="Provide a reason for retrying this delivery..."
                      @bind="_retryJustification"
                      style="resize:vertical;min-height:80px;"
                      disabled="@_isRetrying">
            </textarea>
            @if (_retryJustificationError)
            {
                <span class="form-error">@(string.IsNullOrEmpty(_retryJustificationErrorMessage) ? "Justification is required." : _retryJustificationErrorMessage)</span>
            }
        </div>

        <Alert Type="info"
               Message="This will re-queue the delivery for processing. The retry cycle will be incremented by one." />

        <Alert Message="@_retryErrorMessage" />

    </Modal>
}

@code {

    [Parameter] public Guid DeliveryId { get; set; }

    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool   _isLoading   = true;
    private bool   _isFiltering = false;
    private string _errorMessage = string.Empty;

    // Filters
    private DateTime? _filterDateFrom = null;
    private DateTime? _filterDateTo   = null;
    private string    _filterRetried  = string.Empty;

    // Data
    private List<DeadLetterQueueDto> _deadLetters = [];

    // Detail modal
    private bool               _showDetailModal  = false;
    private DeadLetterQueueDto? _selectedDeadLetter;

    // Retry modal
    private bool   _showRetryModal    = false;
    private bool   _isRetrying        = false;
    private string _retryErrorMessage = string.Empty;
    private bool _retryJustificationError = false;
    private string _retryJustification = string.Empty;
    private string _retryJustificationErrorMessage = string.Empty;

    // -------------------------------------------------------------------------
    // Computed
    // -------------------------------------------------------------------------

    private bool HasActiveFilters =>
    _filterDateFrom.HasValue ||
        _filterDateTo.HasValue   ||
        !string.IsNullOrWhiteSpace(_filterRetried);

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
        => await LoadDeadLettersAsync();

    private async Task LoadDeadLettersAsync()
    {
        _isLoading    = true;
        _errorMessage = string.Empty;


        try
        {
            var result = await getDeliveryDeadLettersHandler
                .HandleAsync(deliveryId: DeliveryId);

            if (!result.responseDetails.successStatus)
            {
                _errorMessage = $"Failed to load dead letters. " +
                                $"{result.responseDetails.responseMessage}";
                return;
            }

            _deadLetters = result.responseItems?.ToList() ?? [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // -------------------------------------------------------------------------
    // Filters
    // -------------------------------------------------------------------------

    private async Task ApplyFilters()
    {
        _isFiltering = true;
        try { await LoadDeadLettersAsync(); }
        finally { _isFiltering = false; }
    }

    private async Task ClearFilters()
    {
        _filterDateFrom = null;
        _filterDateTo   = null;
        _filterRetried  = string.Empty;
        await ApplyFilters();
    }

    // -------------------------------------------------------------------------
    // Modal handlers
    // -------------------------------------------------------------------------

    private void OpenDetailModal(DeadLetterQueueDto dl)
    {
        _selectedDeadLetter = dl;
        _showDetailModal    = true;
    }

    private void OpenRetryModal(DeadLetterQueueDto dl)
    {
        _selectedDeadLetter = dl;
        _retryErrorMessage  = string.Empty;
        _showRetryModal     = true;
        _retryJustificationError = false;
        _retryJustification = string.Empty;
    }

    private void OpenRetryModalFromDetails(DeadLetterQueueDto dl)
    {
        var tempSelected = dl;
        CloseModals();
        OpenRetryModal(tempSelected);
    }

    private void CloseModals()
    {
        _showDetailModal    = false;
        _showRetryModal     = false;
        _selectedDeadLetter = null;
        _retryErrorMessage  = string.Empty;
        _retryJustificationError = false;
        _retryJustification = string.Empty;
    }

    private async Task HandleRetry()
    {
        if (_selectedDeadLetter is null) return;

        _retryErrorMessage = string.Empty;
        _retryJustificationError = false;

        if (string.IsNullOrEmpty(_retryJustification))
        {
            _retryJustificationError = true;
            return;
        }

        if(_retryJustification.Length > 500)
        {
            _retryJustificationError = true;
            _retryJustificationErrorMessage = "Justification cannot exceed 500 characters.";
        }

        
        _isRetrying        = true;
        _retryErrorMessage = string.Empty;

        try
        {
            var result = await requestDeadLetterDeliveryRetryHandler.HandleAsync(DeliveryId, new RequestManualRetryDto(){ DeadLetterId = _selectedDeadLetter.id, DeliveryId = DeliveryId, RetryJustification = _retryJustification });

            if (!result.successStatus)
            {
                _retryErrorMessage = result.responseMessage;
                return;
            }


            // Update local state — mark as retried
            var index = _deadLetters.IndexOf(_selectedDeadLetter);
            if (index >= 0)
            {
                _deadLetters[index] = _selectedDeadLetter with
                {
                    RetriedAt = DateTimeOffset.UtcNow
                };
            }

            toastService.ShowSuccess("Delivery queued for retry successfully.", durationMs: 10000);
            CloseModals();
        }
        finally
        {
            _isRetrying = false;
        }
    }
}
