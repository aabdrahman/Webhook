@*
    LoadingButton — a button that manages its own loading state

    Parameters:
    - Text:        button label when idle (required)
    - LoadingText: label shown while loading (default: "Please wait...")
    - IsLoading:   controls the loading state from the parent
    - OnClick:     async callback executed on click
    - Variant:     "primary" | "secondary" | "danger" | "ghost" | "outline" (default: "primary")
    - Size:        "sm" | "md" | "lg" (default: "md")
    - FullWidth:   stretches button to 100% width (default: false)
    - Disabled:    disables the button regardless of loading state (default: false)
    - Type:        "button" | "submit" | "reset" (default: "button")

    Usage:
        <LoadingButton Text="Login"
                       LoadingText="Signing in..."
                       IsLoading="@_isLoading"
                       OnClick="HandleLogin" />

        <LoadingButton Text="Delete"
                       Variant="danger"
                       IsLoading="@_isDeleting"
                       OnClick="HandleDelete" />

        <LoadingButton Text="Save Changes"
                       IsLoading="@_isSaving"
                       FullWidth="true"
                       OnClick="HandleSave" />
*@

<button class="btn btn-@Variant @SizeClass @(FullWidth ? "btn-full" : "") @(IsLoading ? "loading" : "")"
        type="@Type"
        disabled="@(IsLoading || Disabled)"
        @onclick="HandleClick">

    @if (IsLoading)
    {
        <span class="btn-spinner" aria-hidden="true"></span>
        <span>@LoadingText</span>
    }
    else
    {
        @if (IconContent is not null)
        {
            @IconContent
        }
        <span>@Text</span>
    }

</button>

@code {

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter] public string          LoadingText  { get; set; } = "Please wait...";
    [Parameter] public bool            IsLoading    { get; set; } = false;
    [Parameter] public EventCallback   OnClick      { get; set; }
    [Parameter] public string          Variant      { get; set; } = "primary";
    [Parameter] public string          Size         { get; set; } = "md";
    [Parameter] public bool            FullWidth    { get; set; } = false;
    [Parameter] public bool            Disabled     { get; set; } = false;
    [Parameter] public string          Type         { get; set; } = "button";
    [Parameter] public RenderFragment? IconContent  { get; set; }

    private string SizeClass => Size switch
    {
        "sm" => "btn-sm",
        "lg" => "btn-lg",
        _    => ""
    };

    private async Task HandleClick()
    {
        if (IsLoading || Disabled) return;
        await OnClick.InvokeAsync();
    }
}
