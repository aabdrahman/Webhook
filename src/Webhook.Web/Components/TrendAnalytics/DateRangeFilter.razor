@* Components/Analytics/Shared/DateRangeFilter.razor *@

<div class="analytics-topbar__right">
    <div class="analytics-date-picker">
        <span>📅</span>
        <span class="analytics-date-picker__label">@ActivePeriodLabel</span>
        @if (ActivePeriod != Period.Custom)
        {
            <span class="analytics-date-picker__range">(@RangeText)</span>
        }
    </div>

    <div class="analytics-period-pills">
        @foreach (var p in Enum.GetValues<Period>())
        {
            <button class="analytics-period-pill @(ActivePeriod == p ? "analytics-period-pill--active" : "")"
                    @onclick="() => SelectPeriod(p)">
                @PeriodLabel(p)
            </button>
        }
    </div>

    @if (ActivePeriod == Period.Custom)
    {
        <input type="date" class="analytics-filter-select" style="width:130px"
               @bind="CustomFrom" @bind:after="NotifyChanged" />
        <span style="font-size:0.75rem;color:var(--text-muted)">–</span>
        <input type="date" class="analytics-filter-select" style="width:130px"
               @bind="CustomTo" @bind:after="NotifyChanged" />
    }
</div>

@code {
    public enum Period { Days7, Days30, Days90, Custom }

    [Parameter] public Period     ActivePeriod { get; set; } = Period.Days30;
    [Parameter] public DateOnly   CustomFrom   { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
    [Parameter] public DateOnly   CustomTo     { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    [Parameter] public EventCallback<(Period Period, DateOnly From, DateOnly To)> OnChanged { get; set; }

    private string ActivePeriodLabel => PeriodLabel(ActivePeriod);

    private string RangeText
    {
        get
        {
            var (from, to) = GetRange(ActivePeriod);
            return $"{from:MMM d, yyyy} – {to:MMM d, yyyy}";
        }
    }

    private static string PeriodLabel(Period p) => p switch
    {
        Period.Days7  => "7d",
        Period.Days30 => "30d",
        Period.Days90 => "90d",
        Period.Custom => "Custom",
        _             => "30d"
    };

    private static (DateOnly From, DateOnly To) GetRange(Period p)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return p switch
        {
            Period.Days7  => (today.AddDays(-7),  today),
            Period.Days30 => (today.AddDays(-30), today),
            Period.Days90 => (today.AddDays(-90), today),
            _             => (today.AddDays(-30), today)
        };
    }

    private async Task SelectPeriod(Period p)
    {
        ActivePeriod = p;
        if (p != Period.Custom)
        {
            (CustomFrom, CustomTo) = GetRange(p);
        }
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        await OnChanged.InvokeAsync((ActivePeriod, CustomFrom, CustomTo));
    }
}
