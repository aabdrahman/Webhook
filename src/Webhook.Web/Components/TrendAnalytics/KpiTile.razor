@* Components/Analytics/Shared/KpiTile.razor *@

@if (IsLoading)
{
    <div class="analytics-skeleton analytics-skeleton--kpi"></div>
}
else
{
    <div class="analytics-kpi-tile">
        <div class="analytics-kpi-tile__icon analytics-kpi-tile__icon--@Accent.ToString().ToLower()">
            @Icon
        </div>
        <div class="analytics-kpi-tile__body">
            <div class="analytics-kpi-tile__label">@Label</div>
            <div class="analytics-kpi-tile__value">@Value</div>
            @if (!string.IsNullOrEmpty(Trend))
            {
                <div class="analytics-kpi-tile__trend">
                    <span class="analytics-kpi-tile__trend-value--@(TrendUp ? "up" : "down")">
                        @(TrendUp ? "↑" : "↓") @Trend
                    </span>
                    @if (!string.IsNullOrEmpty(TrendNote))
                    {
                        <span>@TrendNote</span>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    public enum KpiAccent { Blue, Green, Red, Amber, Purple }

    [Parameter, EditorRequired] public string Label   { get; set; } = "";
    [Parameter, EditorRequired] public string Value   { get; set; } = "—";
    [Parameter]                 public string Icon     { get; set; } = "📊";
    [Parameter]                 public string? Trend   { get; set; }
    [Parameter]                 public string? TrendNote { get; set; }

    /// <summary>True = trend is a positive direction (green ↑). False = negative (red ↓).</summary>
    [Parameter] public bool TrendUp { get; set; } = true;

    [Parameter] public KpiAccent Accent    { get; set; } = KpiAccent.Blue;
    [Parameter] public bool      IsLoading { get; set; }
}
