@* 
    Spinner — standalone loading indicator
    
    Parameters:
    - Size: "sm" | "md" | "lg" (default: "md")
    - Centered: wraps the spinner in a centred flex container (default: false)
    - Label: optional accessible screen-reader label (default: "Loading...")
*@

<div class="@WrapperClass" role="status" aria-label="@Label">
    <div class="spinner @SizeClass"></div>
    <span class="sr-only">@Label</span>
</div>

@code {

    [Parameter] public string Size     { get; set; } = "md";
    [Parameter] public bool   Centered { get; set; } = false;
    [Parameter] public string Label    { get; set; } = "Loading...";

    private string SizeClass => Size switch
    {
        "sm" => "spinner-sm",
        "lg" => "spinner-lg",
        _    => "spinner-md"
    };

    private string WrapperClass => Centered
        ? "spinner-center"
        : "spinner-wrapper";
}
