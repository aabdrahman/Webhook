
@*
    ToastContainer — renders all active toasts in the top-right corner.
    Placed once in MainLayout.razor.
    Subscribes to ToastService and re-renders when the queue changes.
*@


@implements IDisposable

<div class="toast-container" aria-label="Notifications" aria-live="polite">
    @foreach (var toast in toastService.Toasts)
    {
        <Toast ToastMessage="@toast"
               OnDismiss="@HandleDismiss"
               key="@toast.Id" />
    }
</div>

@code {

    protected override void OnInitialized()
    {
        toastService.OnToastsChanged += HandleToastsChanged;
    }

    private void HandleToastsChanged()
    {
        // Marshal back to the UI thread — ToastService auto-dismiss
        // runs on a background Task so we need InvokeAsync
        InvokeAsync(StateHasChanged);
    }

    private void HandleDismiss(Guid id)
    {
        toastService.Remove(id);
    }

    public void Dispose()
    {
        toastService.OnToastsChanged -= HandleToastsChanged;
    }
}
